{
  "mcpServers": {
    "filesystem": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${PROJECT_ROOT}"
      ],
      "alwaysAllow": [
        "read_file",
        "read_text_file",
        "read_multiple_files",
        "write_file",
        "edit_file",
        "list_directory",
        "create_directory",
        "list_directory_with_sizes",
        "move_file",
        "search_files",
        "get_file_info",
        "list_allowed_directories",
        "directory_tree",
        "read_media_file"
      ]
    },
    "qdrant": {
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "mcp-server-qdrant",
        "--transport",
        "stdio"
      ],
      "env": {
        "QDRANT_URL": "http://localhost:6333",
        "QDRANT_API_KEY": "unitykb",
        "COLLECTION_NAME": "unity_codebase"
      }
    },
    "serena-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project",
        "ml-agents"
      ]
    },
    "sequentialthinking": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "unityMCP": {
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "--no-cache",
        "--refresh",
        "--from",
        "D:\\GithubRepos\\unity-mcp-beta\\Server",
        "mcp-for-unity",
        "--transport",
        "stdio"
      ]
    }
  }
}
