    public abstract class LLM : System.IDisposable
    {
        protected readonly object _disposeLock = new();
        public bool disposed;
        public LlamaLib llamaLib;
        public nint llm;
        protected LLM() {}
        protected LLM(LlamaLib llamaLibInstance) {}
        public string ApplyTemplate(Newtonsoft.Json.Linq.JArray messages = default(Newtonsoft.Json.Linq.JArray));
        public void CheckCompletionInternal(string prompt);
        protected void CheckLlamaLib();
        public string Completion(string prompt, LlamaLib.CharArrayCallback callback = default(LlamaLib.CharArrayCallback), int idSlot = -1);
        public async System.Threading.Tasks.Task<string> CompletionAsync(string prompt, LlamaLib.CharArrayCallback callback = default(LlamaLib.CharArrayCallback), int idSlot = -1);
        public string CompletionInternal(string prompt, LlamaLib.CharArrayCallback callback, int idSlot);
        public static void Debug(int debugLevel);
        public string Detokenize(System.Collections.Generic.List<int> tokens);
        public string Detokenize(int[] tokens);
        public virtual void Dispose();
        public System.Collections.Generic.List<float> Embeddings(string content);
        protected override void Finalize();
        public Newtonsoft.Json.Linq.JObject GetCompletionParameters();
        public string GetGrammar();
        public static void LoggingCallback(LlamaLib.CharArrayCallback callback);
        public static void LoggingStop();
        public void SetCompletionParameters(Newtonsoft.Json.Linq.JObject parameters = default(Newtonsoft.Json.Linq.JObject));
        public void SetGrammar(string grammar);
        public System.Collections.Generic.List<int> Tokenize(string content);
    }

    public class LLMAgent : LLMLocal
    {
        public Newtonsoft.Json.Linq.JArray History { get; set; }
        public int SlotId { get; set; }
        public string SystemPrompt { get; set; }
        public LLMAgent(LLMLocal _llm, string _systemPrompt = @"") {}
        public void AddAssistantMessage(string content);
        public void AddUserMessage(string content);
        public void Cancel();
        public string Chat(string userPrompt, bool addToHistory = true, LlamaLib.CharArrayCallback callback = default(LlamaLib.CharArrayCallback), bool returnResponseJson = false, bool debugPrompt = false);
        public async System.Threading.Tasks.Task<string> ChatAsync(string userPrompt, bool addToHistory = true, LlamaLib.CharArrayCallback callback = default(LlamaLib.CharArrayCallback), bool returnResponseJson = false, bool debugPrompt = false);
        public void ClearHistory();
        public string Completion(string prompt, LlamaLib.CharArrayCallback callback = default(LlamaLib.CharArrayCallback));
        public async System.Threading.Tasks.Task<string> CompletionAsync(string prompt, LlamaLib.CharArrayCallback callback = default(LlamaLib.CharArrayCallback));
        public System.Collections.Generic.List<ChatMessage> GetHistory();
        public int GetHistorySize();
        public void LoadHistory(string filepath);
        public string LoadSlot(string filepath);
        public void RemoveLastMessage();
        public void SaveHistory(string filepath);
        public string SaveSlot(string filepath);
        public void SetHistory(System.Collections.Generic.List<ChatMessage> messages);
    }

    public class LLMClient : LLMLocal
    {
        public LLMClient(LLMProvider provider) {}
        public LLMClient(string url, int port, string apiKey = @"", int numRetries = 5) {}
        public bool IsServerAlive();
        public void SetSSL(string SSL_cert);
    }

    public abstract class LLMLocal : LLM
    {
        protected LLMLocal() {}
        protected LLMLocal(LlamaLib llamaLibInstance) {}
        public void Cancel(int idSlot);
        public string LoadSlot(int idSlot, string filepath);
        public string SaveSlot(int idSlot, string filepath);
    }

    public abstract class LLMProvider : LLMLocal
    {
        protected LLMProvider() {}
        protected LLMProvider(LlamaLib llamaLibInstance) {}
        public string BuildLoraWeightJSON(System.Collections.Generic.List<LoraIdScale> loras);
        public override void Dispose();
        public int EmbeddingSize();
        public void EnableReasoning(bool enableReasoning);
        public void JoinServer();
        public void JoinService();
        public System.Collections.Generic.List<LoraIdScalePath> LoraList();
        public string LoraListJSON();
        public bool LoraWeight(System.Collections.Generic.List<LoraIdScale> loras);
        public bool LoraWeight(params LoraIdScale[] loras);
        public System.Collections.Generic.List<LoraIdScalePath> ParseLoraListJSON(string result);
        public void SetSSL(string sslCert, string sslKey);
        public bool Start();
        public async System.Threading.Tasks.Task<bool> StartAsync();
        public bool Started();
        public void StartServer(string host = @"0.0.0.0", int port = -1, string apiKey = @"");
        public void Stop();
        public void StopServer();
    }

    public class LLMService : LLMProvider
    {
        public string Command { get; set; }
        public LLMService(LlamaLib llamaLibInstance, nint llmInstance) {}
        public LLMService(string modelPath, int numSlots = 1, int numThreads = -1, int numGpuLayers = 0, bool flashAttention = false, int contextSize = 4096, int batchSize = 2048, bool embeddingOnly = false, string[] loraPaths = default(string[])) {}
        public static nint CreateLLM(LlamaLib llamaLib, string modelPath, int numSlots, int numThreads, int numGpuLayers, bool flashAttention, int contextSize, int batchSize, bool embeddingOnly, string[] loraPaths);
        public static LLMService FromCommand(string paramsString);
    }

    public struct LoraIdScale
    {
        public int Id { get; set; }
        public float Scale { get; set; }
        public LoraIdScale(int id, float scale) {}
    }

    public struct LoraIdScalePath
    {
        public int Id { get; set; }
        public string Path { get; set; }
        public float Scale { get; set; }
        public LoraIdScalePath(int id, float scale, string path) {}
    }
}
