    [UnityEngine.RequireComponent(typeof(UnityEngine.CharacterController))] [UnityEngine.RequireComponent(typeof(UnityEngine.InputSystem.PlayerInput))] public class ThirdPersonController : Unity.Netcode.NetworkBehaviour
    {
        [UnityEngine.Tooltip(@"How far in degrees can you move the camera down")] public float BottomClamp = -30f;
        [UnityEngine.Tooltip(@"Additional degrees to override the camera")] public float CameraAngleOverride;
        [UnityEngine.Tooltip(@"Layers checked for ceiling clearance when standing up from crouch. Defaults to GroundLayers if left empty.")] public UnityEngine.LayerMask CeilingLayers;
        [UnityEngine.Header(@"Cinemachine")] [UnityEngine.Tooltip(@"The follow target set in the Cinemachine Virtual Camera")] public UnityEngine.GameObject CinemachineCameraTarget;
        [UnityEngine.Tooltip(@"CharacterController center Y offset when crouching")] public float CrouchCenterY = 0.5f;
        [UnityEngine.Header(@"Crouch")] [UnityEngine.Tooltip(@"CharacterController height when crouching")] public float CrouchHeight = 1f;
        [UnityEngine.Tooltip(@"Crouch speed of the character in m/s")] public float CrouchSpeed = 1.2f;
        [UnityEngine.Tooltip(@"Speed to interpolate crouch height changes")] public float CrouchTransitionSpeed = 10f;
        [UnityEngine.Tooltip(@"Time required to pass before entering the fall state. Useful for walking down stairs")] public float FallTimeout = 0.15f;
        [UnityEngine.Min(0f)] [UnityEngine.Tooltip(@"Bank amount from lateral flight velocity.")] public float FlyBankFromStrafe = 18f;
        [UnityEngine.Min(0f)] [UnityEngine.Tooltip(@"Additional bank from yaw turn correction while camera-aligning.")] public float FlyBankFromTurn = 12f;
        [UnityEngine.Range(0f, 60f)] [UnityEngine.Tooltip(@"Maximum body bank while turning/curving in fly mode (degrees).")] public float FlyBankMax = 24f;
        [UnityEngine.Min(0.01f)] [UnityEngine.Tooltip(@"How quickly body bank follows turn/strafe changes.")] public float FlyBankSmoothTime = 0.1f;
        [UnityEngine.Header(@"Fly Orientation")] [UnityEngine.Range(0f, 75f)] [UnityEngine.Tooltip(@"Maximum up/down body pitch while flying (degrees).")] public float FlyPitchMax = 32f;
        [UnityEngine.Min(0.01f)] [UnityEngine.Tooltip(@"How quickly body pitch follows vertical flight velocity.")] public float FlyPitchSmoothTime = 0.12f;
        public UnityEngine.AudioClip[] FootstepAudioClips;
        [UnityEngine.Range(0f, 1f)] public float FootstepAudioVolume = 0.5f;
        [UnityEngine.Tooltip(@"The character uses its own gravity value. The engine default is -9.81f")] public float Gravity = -15f;
        [UnityEngine.Header(@"Player Grounded")] [UnityEngine.Tooltip(@"If the character is grounded or not")] public bool Grounded = true;
        [UnityEngine.Tooltip(@"Useful for rough ground")] public float GroundedOffset = -0.14f;
        [UnityEngine.Tooltip(@"The radius of the grounded check. Should match the radius of the CharacterController")] public float GroundedRadius = 0.28f;
        [UnityEngine.Tooltip(@"What layers the character uses as ground")] public UnityEngine.LayerMask GroundLayers;
        [UnityEngine.Header(@"Landing")] [UnityEngine.Tooltip(@"Fall time (seconds) before a landing counts as hard")] public float HardLandingFallTime = 0.8f;
        [UnityEngine.Header(@"Idle Variants")] [UnityEngine.Tooltip(@"Seconds of standing still before cycling to a random idle variant")] public float IdleVariantInterval = 8f;
        [UnityEngine.Tooltip(@"Invert flight banking direction if the rig feels mirrored.")] public bool InvertFlyBank;
        [UnityEngine.Space(10f)] [UnityEngine.Tooltip(@"The height the player can jump")] public float JumpHeight = 1.2f;
        [UnityEngine.Space(10f)] [UnityEngine.Tooltip(@"Time required to pass before being able to jump again. Set to 0f to instantly jump again")] public float JumpTimeout = 0.5f;
        public UnityEngine.AudioClip LandingAudioClip;
        [UnityEngine.Tooltip(@"For locking the camera position on all axis")] public bool LockCameraPosition;
        [UnityEngine.Header(@"Player")] [UnityEngine.Tooltip(@"Walk speed of the character in m/s")] public float MoveSpeed = 2f;
        [UnityEngine.Range(0f, 0.3f)] [UnityEngine.Tooltip(@"How fast the character turns to face movement direction")] public float RotationSmoothTime = 0.12f;
        [UnityEngine.Tooltip(@"Acceleration and deceleration")] public float SpeedChangeRate = 10f;
        [UnityEngine.Tooltip(@"Sprint speed of the character in m/s")] public float SprintSpeed = 5.335f;
        [UnityEngine.Tooltip(@"How far in degrees can you move the camera up")] public float TopClamp = 70f;
        public ThirdPersonController() {}
        protected override string __getTypeName();
        protected override void __initializeRpcs();
        protected override void __initializeVariables();
        public override void OnGainedOwnership();
        public override void OnLostOwnership();
        public override void OnNetworkDespawn();
        public override void OnNetworkSpawn();
    }
}

