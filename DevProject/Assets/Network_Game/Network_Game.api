    [UnityEngine.CreateAssetMenu(fileName = @"EffectDefinition", menuName = @"Dialogue/Effect Definition")] public class EffectDefinition : UnityEngine.ScriptableObject
    {
        [UnityEngine.Tooltip(@"If true, damage is applied only to objects recognized as player actors")] public bool affectPlayerOnly = true;
        [UnityEngine.Tooltip(@"Allow the LLM to override color via 'Color: X' parameter")] public bool allowCustomColor = true;
        [UnityEngine.Tooltip(@"Allow the LLM to override duration via 'Duration: X' parameter")] public bool allowCustomDuration = true;
        [UnityEngine.Header(@"Parameter Schema")] [UnityEngine.Tooltip(@"Allow the LLM to override scale via 'Scale: X' parameter")] public bool allowCustomScale = true;
        [UnityEngine.Header(@"Legacy Compatibility")] [UnityEngine.Tooltip(@"Alternative tags that also trigger this effect (for backwards compatibility)")] public string[] alternativeTags;
        [UnityEngine.Tooltip(@"Optional bone/transform hint for future attachment logic (e.g. Head, Spine).")] public string attachBone;
        [UnityEngine.Min(0f)] [UnityEngine.Tooltip(@"Damage applied on impact")] public float damageAmount = 10f;
        [UnityEngine.Min(0.1f)] [UnityEngine.Tooltip(@"Impact overlap radius used for damage application")] public float damageRadius = 1f;
        [UnityEngine.Tooltip(@"Damage type label used for logs/telemetry")] public string damageType = @"effect";
        [UnityEngine.Tooltip(@"Default color when not specified")] public UnityEngine.Color defaultColor;
        [UnityEngine.Tooltip(@"Default duration in seconds when not specified")] public float defaultDuration = 4f;
        [UnityEngine.Header(@"Default Parameters")] [UnityEngine.Tooltip(@"Default scale multiplier when not specified in the effect tag")] public float defaultScale = 1f;
        [UnityEngine.Header(@"Human-readable description for the LLM prompt")] [UnityEngine.TextArea(3, 6)] public string description;
        [UnityEngine.Header(@"Prefab that will be instantiated")] public UnityEngine.GameObject effectPrefab;
        [UnityEngine.Header(@"Tag that the LLM must emit")] [UnityEngine.Tooltip(@"Exact name used in [EFFECT: TagName]")] public string effectTag;
        [UnityEngine.Header(@"Gameplay (Optional)")] [UnityEngine.Tooltip(@"When enabled, the spawned effect can apply gameplay damage")] public bool enableGameplayDamage;
        [UnityEngine.Tooltip(@"When enabled, projectile movement steers toward the selected target")] public bool enableHoming;
        [UnityEngine.Min(0f)] [UnityEngine.Tooltip(@"Maximum steering rotation speed (degrees/second) for homing projectiles")] public float homingTurnRateDegrees = 240f;
        [UnityEngine.Min(0.1f)] public float maxDuration = 20f;
        [UnityEngine.Min(0.1f)] public float maxRadius = 25f;
        [UnityEngine.Min(0.1f)] public float maxScale = 20f;
        [UnityEngine.Min(0.05f)] public float minDuration = 0.2f;
        [UnityEngine.Min(0.1f)] public float minRadius = 0.25f;
        [UnityEngine.Min(0.1f)] public float minScale = 0.25f;
        [UnityEngine.Header(@"Execution Profile")] [UnityEngine.Tooltip(@"Default placement behavior for this effect when parser hints are ambiguous.")] public EffectPlacementMode placementMode;
        [UnityEngine.Tooltip(@"When true and placement is mesh-attached, try to fit to target render bounds.")] public bool preferFitTargetMesh = true;
        [UnityEngine.Min(0.1f)] [UnityEngine.Tooltip(@"Projectile travel speed in meters per second")] public float projectileSpeed = 10f;
        [UnityEngine.Tooltip(@"Expected semantic target for this effect.")] public EffectTargetType targetType;
        public EffectDefinition() {}
    }

