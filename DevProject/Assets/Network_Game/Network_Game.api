        [UnityEngine.Tooltip(@"When enabled, projectile movement steers toward the selected target.")] public bool EnableHoming;
        [UnityEngine.Min(0f)] public float ForwardDistance = 2f;
        [UnityEngine.Min(0f)] [UnityEngine.Tooltip(@"Maximum steering rotation speed (degrees/second) for homing projectiles.")] public float HomingTurnRateDegrees = 240f;
        public string[] Keywords;
        public string PowerName = @"New Power";
        [UnityEngine.Min(0.1f)] [UnityEngine.Tooltip(@"Projectile travel speed in meters per second.")] public float ProjectileSpeed = 10f;
        [UnityEngine.Min(0.1f)] public float Scale = 1f;
        public bool SpawnInFrontOfNpc = true;
        public UnityEngine.Vector3 SpawnOffset;
        public bool UseColorOverride;
        [UnityEngine.Tooltip(@"Short visual description injected into LLM prompt for creative effect decisions.")] public string VisualDescription = @"";
        public PrefabPowerEntry() {}
        public Effects.EffectDefinition ToEffectDefinition();
    }

