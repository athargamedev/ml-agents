<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="PlayerProfileUI" src="project://database/Assets/Network_Game/UI/Profile/PlayerProfileUI.uxml?fileID=9197481963319205126&amp;guid=9c8fc3d7ab9cd2d44b6ccf544b033e28&amp;type=3#PlayerProfileUI"/>
    <Style src="project://database/Assets/Network_Game/UI/BlocksShared.uss?fileID=7433441132597879392&amp;guid=5b446a577d2cebf4d8d926d521552982&amp;type=3#BlocksShared"/>
    <ui:VisualElement name="root" class="blocks-login-container">
        <ui:VisualElement class="blocks-modal blocks-login-modal" style="flex-direction: column; width: 372px; height: 591px;">
            <ui:Label text="PLAYER IDENTITY" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" class="blocks-header blocks-header--space-bottom" style="height: 0; width: 90%; padding-left: 10px; padding-right: 10px; margin-bottom: 0; padding-top: 10px; padding-bottom: 10px; font-size: 20px; letter-spacing: 1px; transition-duration: 1s;"/>
            <ui:VisualElement class="blocks-login-input-group" style="height: 87px; width: 319px;">
                <ui:Label text="IDENTIFIER (NAME_ID)" class="blocks-login-label"/>
                <ui:TextField name="name-input" placeholder-text="Enter your name" select-all-on-mouse-up="false" select-all-on-focus="false" select-word-by-double-click="false" emoji-fallback-support="false" select-line-by-triple-click="false" class="blocks-textfield" style="font-size: 16px; min-height: 30px; min-width: 100px; margin-top: 1px; margin-bottom: 1px; margin-left: 0; margin-right: 0; transition-duration: 1s;"/>
            </ui:VisualElement>
            <ui:VisualElement class="blocks-login-input-group">
                <ui:Label text="BIO / CUSTOMIZATION (JSON)" class="blocks-login-label"/>
                <ui:TextField name="bio-input" multiline="true" placeholder-text="{&quot;role&quot;: &quot;Scout&quot;, &quot;level&quot;: 5}" select-all-on-mouse-up="false" select-all-on-focus="false" select-word-by-double-click="false" select-line-by-triple-click="false" emoji-fallback-support="false" class="blocks-textfield" style="height: auto; font-size: 15px; margin-left: 1px; margin-right: 1px; width: auto;"/>
            </ui:VisualElement>
            <ui:Button name="login-button" text="SET IDENTITY" class="blocks-button blocks-login-button"/>
            <ui:Label name="status-label" text="Ready to bind identity" class="blocks-chat-message__text" style="border-width: 0; color: rgba(255, 255, 255, 0.5); -unity-text-align: middle-center; margin-top: 10px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Instance template="PlayerProfileUI"/>
</ui:UXML>
