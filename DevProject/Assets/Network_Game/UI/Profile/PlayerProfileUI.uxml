<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="ModernDialogueUI" src="project://database/Assets/Network_Game/UI/Dialogue/ModernDialogueUI.uxml?fileID=9197481963319205126&amp;guid=e8e6fd509b82d9a4d806becbfb1fedb4&amp;type=3#ModernDialogueUI"/>
    <Style src="project://database/Assets/Network_Game/UI/BlocksShared.uss?fileID=7433441132597879392&amp;guid=5b446a577d2cebf4d8d926d521552982&amp;type=3#BlocksShared"/>
    <ui:VisualElement name="profile-card" class="blocks-profile-card" style="padding-left: 1px; padding-right: 1px; padding-top: 1px; padding-bottom: 1px; max-width: 250px; max-height: none; font-size: 15px; letter-spacing: 1px; background-color: rgba(16, 16, 16, 0.59);">
        <ui:VisualElement class="blocks-profile-card__header" style="border-bottom-width: 1px; height: 20px; width: 90%; padding-bottom: 2px; padding-top: 1px;">
            <ui:Label name="player-name" text="NOT LOGGED IN" class="blocks-header" style="font-size: 14px;"/>
            <ui:Button name="minimize-button" text="—" emoji-fallback-support="false" class="blocks-button--xs blocks-button" style="width: 15px; min-width: auto; height: 15px; opacity: 1;"/>
        </ui:VisualElement>
        <ui:VisualElement name="content" class="blocks-profile-card__content">
            <ui:Label name="player-status" text="Waiting for identity..." class="blocks-login-label" style="padding-top: 2px; padding-bottom: 2px;"/>
            <ui:Label name="player-bio" text="" class="blocks-chat-message__text" style="font-size: 14px; border-width: 0; color: rgb(199, 199, 199);"/>
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-top: 5px;">
                <ui:Label text="NETCODE CLIENT" class="blocks-login-label" style="font-size: 10px;"/>
                <ui:Label name="client-id" text="-" class="blocks-login-label" style="font-size: 14px; color: rgb(255, 255, 255); -unity-font-style: bold; margin-right: 10px; padding-right: 1px; padding-bottom: 2px; padding-top: 2px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Instance template="ModernDialogueUI"/>
</ui:UXML>
