{
  "$schema": "https://raw.githubusercontent.com/sourcebot-dev/sourcebot/main/schemas/v3/index.json",
  "connections": {
    "ml-agents-local": {
      "type": "git",
      "url": "file:///repos/ml-agents"
    }
  },
  "models": [
    {
      "provider": "openai-compatible",
      "model": "qwen2.5-coder-7b-instruct@q4_k_m",
      "displayName": "LM Studio Code Model",
      "baseUrl": "http://host.docker.internal:7002/v1/chat/completions",
      "token": {
        "env": "LM_STUDIO_TOKEN"
      }
    }
  ],
  "settings": {
    "maxFileSize": 1048576,
    "maxTrigramCount": 20000,
    "reindexIntervalMs": 3600000
  }
}
