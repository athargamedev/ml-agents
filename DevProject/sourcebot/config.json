{
  "$schema": "https://raw.githubusercontent.com/sourcebot-dev/sourcebot/main/schemas/v3/index.json",
  "connections": {
    "ml-agents-github": {
      "type": "github",
      "url": "https://github.com",
      "repos": ["athargamedev/ml-agents"],
      "revisions": {
        "branches": ["develop"]
      }
    }
  },
  "models": [
    {
      "provider": "openai-compatible",
      "model": "lmstudio-community/DeepSeek-R1-Distributed-Llama-3.3-70B-Instruct-M2-Server",
      "baseUrl": "http://host.docker.internal:7002/v1",
      "token": {
        "env": "LM_STUDIO_TOKEN"
      }
    }
  ],
  "settings": {
    "maxFileSize": 1048576,
    "maxTrigramCount": 20000,
    "reindexIntervalMs": 3600000
  }
}
