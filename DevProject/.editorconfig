# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# C# files
[*.cs]
# Code style rules
formatters = uncrustify, generic

# Indentation settings
indent_style = space
indent_size = 4

# Unity-specific conventions
# Public properties should use PascalCase
dotnet_naming_rule.unity_public_fields.severity = warning
dotnet_naming_rule.unity_public_fields.symbols = unity_public_fields
dotnet_naming_rule.unity_public_fields.style = pascal_case_style

dotnet_naming_symbols.unity_public_fields.applicable_kinds = property
dotnet_naming_symbols.unity_public_fields.applicable_accessibilities = public

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Disable "this. prefix" - common in Unity
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning

# Async methods should have Async suffix
dotnet_naming_rule.async_methods_end_in_async.severity = warning
dotnet_naming_rule.async_methods_end_in_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_in_async.style = async_end_in_async

dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.applicable_accessibilities = *
dotnet_naming_symbols.async_methods.required_modifiers = async

dotnet_naming_style.async_end_in_async.capitalization = pascal_case
dotnet_naming_style.async_end_in_async.required_suffix = Async

# Assembly Definition Files - enable API scraping
[*.asmdef]
scrape_api = true

# Test assemblies - disable API scraping
[**/Tests/**/*.asmdef]
scrape_api = false

# YAML files (Unity scenes, prefabs, etc)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# Shader files
[*.{shader,hlsl}]
indent_style = space
indent_size = 4

# Disable auto-format for generated files
[**/Generated/**/*.cs]
disable_auto_format = true

# Disable auto-format for third-party code
[**/ThirdParty/**/*.cs]
disable_auto_format = true
