        [NoSaveDuringPlay] [UnityEngine.Tooltip(@"The object that the camera wants to look at (the Aim target).  If this is null, then the vcam's Transform orientation will define the camera's orientation.")] [VcamTargetProperty] public UnityEngine.Transform m_LookAt;
