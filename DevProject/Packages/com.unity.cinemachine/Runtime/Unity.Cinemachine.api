            [UnityEngine.Tooltip(@"The target object to look at.  It may be None, in which case the Offset will specify a point in world space.")] public UnityEngine.Transform LookAt;
            [UnityEngine.Tooltip(@"The offset (in local coords) from the LookAt target's origin.  If LookAt target is None, this will specify a world-space point.")] public UnityEngine.Vector3 Offset;
