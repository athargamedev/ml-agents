        {
            AxisCenter = 0,
            ParentObject = 1,
            TrackingTarget = 2,
            LookAtTarget = 3,
        }
    }

    [CameraPipeline(CinemachineCore.Stage.Body)] [SaveDuringPlay] [System.Obsolete(@"CinemachineOrbitalTransposer has been deprecated. Use CinemachineOrbitalFollow instead")] [UnityEngine.AddComponentMenu(@"")] public class CinemachineOrbitalTransposer : CinemachineTransposer, AxisState.IRequiresInput
