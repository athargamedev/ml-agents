    [RequiredTarget(RequiredTargetAttribute.RequiredTargets.Tracking)] [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Procedural/Extensions/Cinemachine Shot Quality Evaluator")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.ExecuteAlways] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineShotQualityEvaluator.html")] public class CinemachineShotQualityEvaluator : CinemachineExtension, IShotQualityEvaluator
    {
        [UnityEngine.Tooltip(@"Radius of the spherecast that will be done to check for occlusions.")] public float CameraRadius;
        [FoldoutWithEnabledButton(@"Enabled")] public CinemachineShotQualityEvaluator.DistanceEvaluationSettings DistanceEvaluation;
        [TagField] [UnityEngine.Tooltip(@"Obstacles with this tag will be ignored.  It is a good idea to set this field to the target's tag")] public string IgnoreTag;
        [UnityEngine.Tooltip(@"Obstacles closer to the target than this will be ignored")] public float MinimumDistanceFromTarget = 0.2f;
        [UnityEngine.Tooltip(@"Objects on these layers will be detected")] public UnityEngine.LayerMask OcclusionLayers;
        public CinemachineShotQualityEvaluator() {}
        protected override void PostPipelineStageCallback(CinemachineVirtualCameraBase vcam, CinemachineCore.Stage stage, ref CameraState state, float deltaTime);
        public struct DistanceEvaluationSettings
        {
            [UnityEngine.Tooltip(@"If enabled, will evaluate shot quality based on target distance")] public bool Enabled;
            [UnityEngine.Tooltip(@"Shots with targets farther from the camera than this will not get a quality boost")] public float FarLimit;
            [UnityEngine.Tooltip(@"High quality shots will be boosted by this fraction of their normal quality")] public float MaxQualityBoost;
            [UnityEngine.Delayed] [UnityEngine.Tooltip(@"Shots with targets closer to the camera than this will not get a quality boost")] public float NearLimit;
            [UnityEngine.Tooltip(@"If greater than zero, maximum quality boost will occur when target is this far from the camera")] public float OptimalDistance;
        }
    }

