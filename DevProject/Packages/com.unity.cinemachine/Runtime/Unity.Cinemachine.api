    public abstract class CinemachineExtension : UnityEngine.MonoBehaviour
    {
        protected const float Epsilon = 0.0001f;
        public CinemachineVirtualCameraBase ComponentOwner { get; }
        protected CinemachineExtension() {}
        protected virtual void Awake();
        protected virtual void ConnectToVcam(bool connect);
        public virtual void ForceCameraPosition(UnityEngine.Vector3 pos, UnityEngine.Quaternion rot);
        public virtual void ForceCameraPosition(CinemachineVirtualCameraBase vcam, UnityEngine.Vector3 pos, UnityEngine.Quaternion rot);
        protected void GetAllExtraStates<T>(System.Collections.Generic.List<T> list) where T : CinemachineExtension.VcamExtraStateBase, new();
        protected T GetExtraState<T>(CinemachineVirtualCameraBase vcam) where T : CinemachineExtension.VcamExtraStateBase, new();
        public virtual float GetMaxDampTime();
        public void InvokePostPipelineStageCallback(CinemachineVirtualCameraBase vcam, CinemachineCore.Stage stage, ref CameraState state, float deltaTime);
        protected virtual void OnDestroy();
        protected virtual void OnEnable();
        public virtual void OnTargetObjectWarped(CinemachineVirtualCameraBase vcam, UnityEngine.Transform target, UnityEngine.Vector3 positionDelta);
        public virtual bool OnTransitionFromCamera(ICinemachineCamera fromCam, UnityEngine.Vector3 worldUp, float deltaTime);
        protected virtual void PostPipelineStageCallback(CinemachineVirtualCameraBase vcam, CinemachineCore.Stage stage, ref CameraState state, float deltaTime);
        public virtual void PrePipelineMutateCameraStateCallback(CinemachineVirtualCameraBase vcam, ref CameraState curState, float deltaTime);
        protected class VcamExtraStateBase
        {
            public CinemachineVirtualCameraBase Vcam;
            public VcamExtraStateBase() {}
        }
    }

    [UnityEngine.AddComponentMenu(@"Cinemachine/Cinemachine External Camera")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.ExecuteAlways] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineExternalCamera.html")] [UnityEngine.RequireComponent(typeof(UnityEngine.Camera))] public class CinemachineExternalCamera : CinemachineVirtualCameraBase
