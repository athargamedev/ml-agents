        public bool DistanceCacheIsValid();
        public abstract UnityEngine.Quaternion EvaluateLocalOrientation(float pos);
        public abstract UnityEngine.Vector3 EvaluateLocalPosition(float pos);
        public abstract UnityEngine.Vector3 EvaluateLocalTangent(float pos);
        public virtual UnityEngine.Quaternion EvaluateOrientation(float pos);
        public UnityEngine.Quaternion EvaluateOrientationAtUnit(float pos, CinemachinePathBase.PositionUnits units);
        public virtual UnityEngine.Vector3 EvaluatePosition(float pos);
        public UnityEngine.Vector3 EvaluatePositionAtUnit(float pos, CinemachinePathBase.PositionUnits units);
        public virtual UnityEngine.Vector3 EvaluateTangent(float pos);
        public UnityEngine.Vector3 EvaluateTangentAtUnit(float pos, CinemachinePathBase.PositionUnits units);
        public virtual float FindClosestPoint(UnityEngine.Vector3 p, int startSegment, int searchRadius, int stepsPerSegment);
        public float FromPathNativeUnits(float pos, CinemachinePathBase.PositionUnits units);
        public virtual void InvalidateDistanceCache();
        public float MaxUnit(CinemachinePathBase.PositionUnits units);
        public float MinUnit(CinemachinePathBase.PositionUnits units);
        protected virtual void OnEnable();
        public float StandardizePathDistance(float distance);
        public virtual float StandardizePos(float pos);
        public virtual float StandardizeUnit(float pos, CinemachinePathBase.PositionUnits units);
        public float ToNativePathUnits(float pos, CinemachinePathBase.PositionUnits units);
        public class Appearance
        {
            [UnityEngine.Tooltip(@"The color of the path itself when it is inactive in the editor")] public UnityEngine.Color inactivePathColor;
            [UnityEngine.Tooltip(@"The color of the path itself when it is active in the editor")] public UnityEngine.Color pathColor;
            [UnityEngine.Range(0f, 10f)] [UnityEngine.Tooltip(@"The width of the railroad-tracks that are drawn to represent the path")] public float width = 0.2f;
            public Appearance() {}
        }
        public enum PositionUnits
        {
            PathUnits = 0,
            Distance = 1,
            Normalized = 2,
        }
    }

