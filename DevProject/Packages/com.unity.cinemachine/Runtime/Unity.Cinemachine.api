        [UnityEngine.Tooltip(@"Defines the manner in which the orbit surface is constructed.")] public CinemachineOrbitalFollow.OrbitStyles OrbitStyle;
        [UnityEngine.Tooltip(@"Axis controlling the scale of the current distance.  Value is a scalar multiplier and is applied to the specified camera distance.")] public InputAxis RadialAxis;
        [UnityEngine.Tooltip(@"The camera will be placed at this distance from the Follow target.")] public float Radius = 10f;
        [UnityEngine.Tooltip(@"Defines the reference frame for horizontal recentering.  The axis center will be dynamically updated to be behind the selected object.")] public CinemachineOrbitalFollow.ReferenceFrames RecenteringTarget = CinemachineOrbitalFollow.ReferenceFrames.TrackingTarget;
        [UnityEngine.Tooltip(@"Offset from the target object's origin in target-local space. Use this to fine-tune the orbit when the desired focus of the orbit is not the tracked object's origin.")] public UnityEngine.Vector3 TargetOffset;
