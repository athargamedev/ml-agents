    [CameraPipeline(CinemachineCore.Stage.Body)] [SaveDuringPlay] [System.Obsolete(@"CinemachineFramingTransposer has been deprecated. Use CinemachinePositionComposer instead")] [UnityEngine.AddComponentMenu(@"")] public class CinemachineFramingTransposer : CinemachineComponentBase
    {
        [UnityEngine.Tooltip(@"How to adjust the camera to get the desired framing.  You can zoom, dolly in/out, or do both.")] public CinemachineFramingTransposer.AdjustmentMode m_AdjustmentMode;
        [UnityEngine.Range(-0.5f, 0.5f)] [UnityEngine.Tooltip(@"A non-zero bias will move the target position horizontally away from the center of the soft zone.")] public float m_BiasX;
        [UnityEngine.Range(-0.5f, 0.5f)] [UnityEngine.Tooltip(@"A non-zero bias will move the target position vertically away from the center of the soft zone.")] public float m_BiasY;
        [UnityEngine.Tooltip(@"The distance along the camera axis that will be maintained from the Follow target")] public float m_CameraDistance = 10f;
        [UnityEngine.Tooltip(@"Force target to center of screen when this camera activates.  If false, will clamp target to the edges of the dead zone")] public bool m_CenterOnActivate = true;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_DistanceDeadZoneSize")] [UnityEngine.Tooltip(@"The camera will not move along its z-axis if the Follow target is within this distance of the specified camera distance")] public float m_DeadZoneDepth;
        [UnityEngine.Range(0f, 2f)] [UnityEngine.Tooltip(@"Camera will not move vertically if the target is within this range of the position.")] public float m_DeadZoneHeight;
        [UnityEngine.Range(0f, 2f)] [UnityEngine.Space] [UnityEngine.Tooltip(@"Camera will not move horizontally if the target is within this range of the position.")] public float m_DeadZoneWidth;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_FramingMode")] [UnityEngine.Space] [UnityEngine.Tooltip(@"What screen dimensions to consider when framing.  Can be Horizontal, Vertical, or both")] public CinemachineFramingTransposer.FramingMode m_GroupFramingMode = CinemachineFramingTransposer.FramingMode.HorizontalAndVertical;
        [UnityEngine.Tooltip(@"The bounding box of the targets should occupy this amount of the screen space.  1 means fill the whole screen.  0.5 means fill half the screen, etc.")] public float m_GroupFramingSize = 0.8f;
        [UnityEngine.Tooltip(@"If checked, movement along the Y axis will be ignored for lookahead calculations")] public bool m_LookaheadIgnoreY;
        [UnityEngine.Range(0f, 30f)] [UnityEngine.Tooltip(@"Controls the smoothness of the lookahead algorithm.  Larger values smooth out jittery predictions and also increase prediction lag")] public float m_LookaheadSmoothing;
        [UnityEngine.Range(0f, 1f)] [UnityEngine.Space] [UnityEngine.Tooltip(@"This setting will instruct the composer to adjust its target offset based on the motion of the target.  The composer will look at a point where it estimates the target will be this many seconds into the future.  Note that this setting is sensitive to noisy animation, and can amplify the noise, resulting in undesirable camera jitter.  If the camera jitters unacceptably when the target is in motion, turn down this setting, or animate the target more smoothly.")] public float m_LookaheadTime;
        [UnityEngine.Tooltip(@"The maximum distance toward the target that this behaviour is allowed to move the camera.")] public float m_MaxDollyIn = 5000f;
        [UnityEngine.Tooltip(@"The maximum distance away the target that this behaviour is allowed to move the camera.")] public float m_MaxDollyOut = 5000f;
        [UnityEngine.Tooltip(@"Set this to limit how far from the target the camera can get.")] public float m_MaximumDistance = 5000f;
        [UnityEngine.Range(1f, 179f)] [UnityEngine.Tooltip(@"If adjusting FOV, will not set the FOV higher than this.")] public float m_MaximumFOV = 60f;
        [UnityEngine.Tooltip(@"If adjusting Orthographic Size, will not set it higher than this.")] public float m_MaximumOrthoSize = 5000f;
        [UnityEngine.Tooltip(@"Set this to limit how close to the target the camera can get.")] public float m_MinimumDistance = 1f;
        [UnityEngine.Range(1f, 179f)] [UnityEngine.Tooltip(@"If adjusting FOV, will not set the FOV lower than this.")] public float m_MinimumFOV = 3f;
        [UnityEngine.Tooltip(@"If adjusting Orthographic Size, will not set it lower than this.")] public float m_MinimumOrthoSize = 1f;
        [UnityEngine.Range(-0.5f, 1.5f)] [UnityEngine.Space] [UnityEngine.Tooltip(@"Horizontal screen position for target. The camera will move to position the tracked object here.")] public float m_ScreenX = 0.5f;
        [UnityEngine.Range(-0.5f, 1.5f)] [UnityEngine.Tooltip(@"Vertical screen position for target, The camera will move to position the tracked object here.")] public float m_ScreenY = 0.5f;
        [UnityEngine.Range(0f, 2f)] [UnityEngine.Tooltip(@"When target is within this region, camera will gradually move vertically to re-align towards the desired position, depending on the damping speed.")] public float m_SoftZoneHeight = 0.8f;
        [UnityEngine.Range(0f, 2f)] [UnityEngine.Tooltip(@"When target is within this region, camera will gradually move horizontally to re-align towards the desired position, depending on the damping speed.")] public float m_SoftZoneWidth = 0.8f;
        [UnityEngine.Tooltip(@"If set, damping will apply  only to target motion, but not to camera rotation changes.  Turn this on to get an instant response when the rotation changes.  ")] public bool m_TargetMovementOnly = true;
        [UnityEngine.Tooltip(@"Offset from the Follow Target object (in target-local co-ordinates).  The camera will attempt to frame the point which is the target's position plus this offset.  Use it to correct for cases when the target's origin is not the point of interest for the camera.")] public UnityEngine.Vector3 m_TrackedObjectOffset;
        [UnityEngine.Space] [UnityEngine.Tooltip(@"If checked, then then soft zone will be unlimited in size.")] public bool m_UnlimitedSoftZone;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Space] [UnityEngine.Tooltip(@"How aggressively the camera tries to maintain the offset in the X-axis.  Small numbers are more responsive, rapidly translating the camera to keep the target's x-axis offset.  Larger numbers give a more heavy slowly responding camera.  Using different settings per axis can yield a wide range of camera behaviors.")] public float m_XDamping = 1f;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to maintain the offset in the Y-axis.  Small numbers are more responsive, rapidly translating the camera to keep the target's y-axis offset.  Larger numbers give a more heavy slowly responding camera.  Using different settings per axis can yield a wide range of camera behaviors.")] public float m_YDamping = 1f;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to maintain the offset in the Z-axis.  Small numbers are more responsive, rapidly translating the camera to keep the target's z-axis offset.  Larger numbers give a more heavy slowly responding camera.  Using different settings per axis can yield a wide range of camera behaviors.")] public float m_ZDamping = 1f;
        public override bool BodyAppliesAfterAim { get; }
        public override bool IsValid { get; }
        public UnityEngine.Bounds LastBounds { get; }
        public UnityEngine.Matrix4x4 LastBoundsMatrix { get; }
        public override CinemachineCore.Stage Stage { get; }
        public UnityEngine.Vector3 TrackedPoint { get; }
        public CinemachineFramingTransposer() {}
        public override void ForceCameraPosition(UnityEngine.Vector3 pos, UnityEngine.Quaternion rot);
        public override float GetMaxDampTime();
        public override void MutateCameraState(ref CameraState curState, float deltaTime);
        public override void OnTargetObjectWarped(UnityEngine.Transform target, UnityEngine.Vector3 positionDelta);
        public override bool OnTransitionFromCamera(ICinemachineCamera fromCam, UnityEngine.Vector3 worldUp, float deltaTime);
        public enum AdjustmentMode
        {
            ZoomOnly = 0,
            DollyOnly = 1,
            DollyThenZoom = 2,
        }
        public enum FramingMode
        {
            Horizontal = 0,
            Vertical = 1,
            HorizontalAndVertical = 2,
            None = 3,
        }
    }

