    public struct InputAxis
    {
        [UnityEngine.Delayed] [UnityEngine.Tooltip(@"The centered, or at-rest value of this axis.")] public float Center;
        [UnityEngine.Tooltip(@"The valid range for the axis value.  Value will be clamped to this range.")] [Vector2AsRange] public UnityEngine.Vector2 Range;
        [FoldoutWithEnabledButton(@"Enabled")] public InputAxis.RecenteringSettings Recentering;
        [UnityEngine.HideInInspector] public InputAxis.RestrictionFlags Restrictions;
        [NoSaveDuringPlay] [UnityEngine.Tooltip(@"The current value of the axis.  You can drive this directly from a script.")] public float Value;
        [UnityEngine.Tooltip(@"If set, then the axis will wrap around at the min/max values, forming a loop")] public bool Wrap;
        public static InputAxis DefaultMomentary { get; }
        public void CancelRecentering();
        public float ClampValue(float v);
        public float GetClampedValue();
        public float GetNormalizedValue();
        public void Reset();
        public bool TrackValueChange();
        public void TriggerRecentering();
        public void UpdateRecentering(float deltaTime, bool forceCancel);
        public void UpdateRecentering(float deltaTime, bool forceCancel, float center);
        public void Validate();
        public struct RecenteringSettings
        {
            [UnityEngine.Tooltip(@"If set, will enable automatic re-centering of the axis when the game is playing.")] public bool Enabled;
            [UnityEngine.Tooltip(@"How long it takes to reach center once re-centering has started.")] public float Time;
            [UnityEngine.Tooltip(@"If no user input has been detected on the axis for this many seconds, re-centering will begin.")] public float Wait;
            public static InputAxis.RecenteringSettings Default { get; }
            public void Validate();
        }
        [System.Flags] public enum RestrictionFlags
        {
            None = 0,
            RangeIsDriven = 1 << 0,
            NoRecentering = 1 << 1,
            Momentary = 1 << 2,
        }
    }

    [SaveDuringPlay] [UnityEngine.ExecuteAlways] public abstract class InputAxisControllerBase<T> : UnityEngine.MonoBehaviour, IInputAxisController where T : IInputAxisReader, new()
    {
        public bool IgnoreTimeScale;
        [UnityEngine.Tooltip(@"If set, a recursive search for IInputAxisOwners behaviours will be performed.  Otherwise, only behaviours attached directly to this GameObject will be considered, and child objects will be ignored")] public bool ScanRecursively = true;
        [HideIfNoComponent(typeof(CinemachineVirtualCameraBase))] [UnityEngine.Tooltip(@"If set, input will not be processed while the Cinemachine Camera is participating in a blend.")] public bool SuppressInputWhileBlending = true;
        public System.Collections.Generic.List<Controller> Controllers { get; }
        protected InputAxisControllerBase() {}
        public bool ControllersAreValid();
        public Controller GetController(string axisName);
        protected virtual void InitializeControllerDefaultsForAxis(ref readonly IInputAxisOwner.AxisDescriptor axis, Controller controller);
        protected virtual void OnDisable();
        protected virtual void OnEnable();
        protected virtual void OnValidate();
        protected virtual void Reset();
        public void SynchronizeControllers();
        public bool TriggerRecentering(string axisName);
        protected void UpdateControllers();
        protected void UpdateControllers(float deltaTime);
        public class Controller
        {
            [HideFoldout] public DefaultInputAxisDriver Driver;
            [UnityEngine.Tooltip(@"When enabled, this controller will drive the input axis")] public bool Enabled = true;
            [HideFoldout] public T Input;
            public float InputValue;
            [UnityEngine.HideInInspector] public string Name;
            [UnityEngine.HideInInspector] public UnityEngine.Object Owner;
            public Controller() {}
        }
    }

