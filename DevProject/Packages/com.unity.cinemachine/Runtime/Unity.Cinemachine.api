    [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineNoiseProfiles.html")] public sealed class NoiseSettings : SignalSourceAsset
    {
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Orientation")] [UnityEngine.Tooltip(@"These are the noise channels for the virtual camera's orientation. Convincing noise setups typically mix low, medium and high frequencies together, so start with a size of 3")] public NoiseSettings.TransformNoiseParams[] OrientationNoise;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Position")] [UnityEngine.Tooltip(@"These are the noise channels for the virtual camera's position. Convincing noise setups typically mix low, medium and high frequencies together, so start with a size of 3")] public NoiseSettings.TransformNoiseParams[] PositionNoise;
        public override float SignalDuration { get; }
        public NoiseSettings() {}
        public static UnityEngine.Vector3 GetCombinedFilterResults(NoiseSettings.TransformNoiseParams[] noiseParams, float time, UnityEngine.Vector3 timeOffsets);
        public override void GetSignal(float timeSinceSignalStart, out UnityEngine.Vector3 pos, out UnityEngine.Quaternion rot);
        public struct NoiseParams
        {
            [UnityEngine.Tooltip(@"The amplitude of the noise for this channel.  Larger numbers vibrate higher.")] public float Amplitude;
            [UnityEngine.Tooltip(@"If checked, then the amplitude and frequency will not be randomized.")] public bool Constant;
            [UnityEngine.Tooltip(@"The frequency of noise for this channel.  Higher magnitudes vibrate faster.")] public float Frequency;
            public float GetValueAt(float time, float timeOffset);
        }
        public struct TransformNoiseParams
        {
            [UnityEngine.Tooltip(@"Noise definition for X-axis")] public NoiseSettings.NoiseParams X;
            [UnityEngine.Tooltip(@"Noise definition for Y-axis")] public NoiseSettings.NoiseParams Y;
            [UnityEngine.Tooltip(@"Noise definition for Z-axis")] public NoiseSettings.NoiseParams Z;
            public UnityEngine.Vector3 GetValueAt(float time, UnityEngine.Vector3 timeOffsets);
        }
    }

