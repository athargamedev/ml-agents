    [SaveDuringPlay] [System.Obsolete(@"CinemachinePath has been deprecated. Use SplineContainer instead")] [UnityEngine.AddComponentMenu(@"")] [UnityEngine.DisallowMultipleComponent] public class CinemachinePath : CinemachinePathBase
    {
