            [UnityEngine.Serialization.FormerlySerializedAs(@"m_FullHash")] [UnityEngine.Tooltip(@"The full hash of the animation state")] public int FullHash;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_MinDuration")] [UnityEngine.Tooltip(@"The minimum length of time (in seconds) to keep a camera active")] public float MinDuration;
