        public struct Instruction
        {
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_Blend")] [UnityEngine.Tooltip(@"How to blend to the next camera in the list (if any)")] public CinemachineBlendDefinition Blend;
            [ChildCameraProperty] [UnityEngine.Serialization.FormerlySerializedAs(@"m_VirtualCamera")] [UnityEngine.Tooltip(@"The camera to activate when this instruction becomes active")] public CinemachineVirtualCameraBase Camera;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_Hold")] [UnityEngine.Tooltip(@"How long to wait (in seconds) before activating the next camera in the list (if any)")] public float Hold;
            public void Validate();
        }
    }

