    [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Cinemachine Sequencer Camera")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.ExcludeFromPreset] [UnityEngine.ExecuteAlways] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineSequencerCamera.html")] public class CinemachineSequencerCamera : CinemachineCameraManagerBase
    {
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Instructions")] [UnityEngine.Tooltip(@"The set of instructions for enabling child cameras.")] public System.Collections.Generic.List<CinemachineSequencerCamera.Instruction> Instructions = new();
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Loop")] [UnityEngine.Tooltip(@"When enabled, the child vcams will cycle indefinitely instead of just stopping at the last one")] public bool Loop;
        public CinemachineSequencerCamera() {}
        protected override CinemachineVirtualCameraBase ChooseCurrentCamera(UnityEngine.Vector3 worldUp, float deltaTime);
        protected override CinemachineBlendDefinition LookupBlend(ICinemachineCamera outgoing, ICinemachineCamera incoming);
