    [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Procedural/Extensions/Cinemachine Storyboard")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.ExecuteAlways] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineStoryboard.html")] public class CinemachineStoryboard : CinemachineExtension
    {
        [UnityEngine.Range(0f, 1f)] [UnityEngine.Serialization.FormerlySerializedAs(@"m_Alpha")] [UnityEngine.Tooltip(@"The opacity of the image.  0 is transparent, 1 is opaque")] public float Alpha = 1f;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Aspect")] [UnityEngine.Tooltip(@"How to handle differences between image aspect and screen aspect")] public CinemachineStoryboard.FillStrategy Aspect;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Center")] [UnityEngine.Tooltip(@"The screen-space position at which to display the image.  Zero is center")] public UnityEngine.Vector2 Center;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Image")] [UnityEngine.Tooltip(@"The image to display")] public UnityEngine.Texture Image;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_MuteCamera")] [UnityEngine.Tooltip(@"If checked, Camera transform will not be controlled by this virtual camera")] public bool MuteCamera;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_PlaneDistance")] [UnityEngine.Tooltip(@"How far away from the camera is the Canvas generated.")] public float PlaneDistance = 100f;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_RenderMode")] [UnityEngine.Tooltip(@"The render mode of the canvas on which the storyboard is drawn.")] public CinemachineStoryboard.StoryboardRenderMode RenderMode;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Rotation")] [UnityEngine.Tooltip(@"The screen-space rotation to apply to the image")] public UnityEngine.Vector3 Rotation;
        [UnityEngine.Tooltip(@"If checked, all storyboards are globally muted")] public static bool s_StoryboardGlobalMute;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Scale")] [UnityEngine.Tooltip(@"The screen-space scaling to apply to the image")] public UnityEngine.Vector2 Scale;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_ShowImage")] [UnityEngine.Tooltip(@"If checked, the specified image will be displayed as an overlay over the virtual camera's output")] public bool ShowImage = true;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_SortingOrder")] [UnityEngine.Tooltip(@"Allows ordering canvases to render on top or below other canvases.")] public int SortingOrder;
        [UnityEngine.Range(-1f, 1f)] [UnityEngine.Serialization.FormerlySerializedAs(@"m_SplitView")] [UnityEngine.Tooltip(@"Wipe the image on and off horizontally")] public float SplitView;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_SyncScale")] [UnityEngine.Tooltip(@"If checked, X and Y scale are synchronized")] public bool SyncScale = true;
        public CinemachineStoryboard() {}
        protected override void ConnectToVcam(bool connect);
        protected override void PostPipelineStageCallback(CinemachineVirtualCameraBase vcam, CinemachineCore.Stage stage, ref CameraState state, float deltaTime);
        public enum FillStrategy
        {
            BestFit = 0,
            CropImageToFit = 1,
            StretchToFit = 2,
        }
        public enum StoryboardRenderMode
        {
            ScreenSpaceOverlay = 0,
            ScreenSpaceCamera = 1,
        }
    }

    [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Helpers/Cinemachine Target Group")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.ExecuteAlways] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineTargetGroup.html")] public class CinemachineTargetGroup : UnityEngine.MonoBehaviour, ICinemachineTargetGroup
    {
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_PositionMode")] [UnityEngine.Tooltip(@"How the group's position is calculated.  Select GroupCenter for the center of the bounding box, and GroupAverage for a weighted average of the positions of the members.")] public CinemachineTargetGroup.PositionModes PositionMode;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_RotationMode")] [UnityEngine.Tooltip(@"How the group's rotation is calculated.  Select Manual to use the value in the group's transform, and GroupAverage for a weighted average of the orientations of the members.")] public CinemachineTargetGroup.RotationModes RotationMode;
        [NoSaveDuringPlay] [UnityEngine.Tooltip(@"The target objects, together with their weights and radii, that will contribute to the group's average position, orientation, and size.")] public System.Collections.Generic.List<CinemachineTargetGroup.Target> Targets = new();
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_UpdateMethod")] [UnityEngine.Tooltip(@"When to update the group's transform based on the position of the group members")] public CinemachineTargetGroup.UpdateMethods UpdateMethod = CinemachineTargetGroup.UpdateMethods.LateUpdate;
        public UnityEngine.Bounds BoundingBox { get; }
        public bool IsEmpty { get; }
        public bool IsValid { get; }
        [System.Obsolete(@"m_Targets is obsolete.  Please use Targets instead")] public CinemachineTargetGroup.Target[] m_Targets { get; set; }
        public UnityEngine.BoundingSphere Sphere { get; }
        public UnityEngine.Transform Transform { get; }
        public CinemachineTargetGroup() {}
        public void AddMember(UnityEngine.Transform t, float weight, float radius);
        public void DoUpdate();
        public int FindMember(UnityEngine.Transform t);
        public void GetViewSpaceAngularBounds(UnityEngine.Matrix4x4 observer, out UnityEngine.Vector2 minAngles, out UnityEngine.Vector2 maxAngles, out UnityEngine.Vector2 zRange);
        public UnityEngine.Bounds GetViewSpaceBoundingBox(UnityEngine.Matrix4x4 observer, bool includeBehind);
        public UnityEngine.BoundingSphere GetWeightedBoundsForMember(int index);
        public void RemoveMember(UnityEngine.Transform t);
        public enum PositionModes
        {
            GroupCenter = 0,
            GroupAverage = 1,
        }
        public enum RotationModes
        {
            Manual = 0,
            GroupAverage = 1,
        }
        public class Target
        {
            [UnityEngine.Serialization.FormerlySerializedAs(@"target")] [UnityEngine.Tooltip(@"The target object.  This object's position and rotation will contribute to the group's average position and rotation, in accordance with its weight")] public UnityEngine.Transform Object;
            [UnityEngine.Serialization.FormerlySerializedAs(@"radius")] [UnityEngine.Tooltip(@"The radius of the target, used for calculating the bounding box.  Cannot be negative")] public float Radius = 0.5f;
            [UnityEngine.Serialization.FormerlySerializedAs(@"weight")] [UnityEngine.Tooltip(@"How much weight to give the target when averaging.  Cannot be negative")] public float Weight = 1f;
            public Target() {}
        }
        public enum UpdateMethods
        {
            Update = 0,
            FixedUpdate = 1,
            LateUpdate = 2,
        }
    }

