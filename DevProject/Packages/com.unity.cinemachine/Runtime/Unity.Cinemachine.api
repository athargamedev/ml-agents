        [UnityEngine.Header(@"Trigger Object Filter")] [UnityEngine.Serialization.FormerlySerializedAs(@"m_LayerMask")] [UnityEngine.Tooltip(@"Only collisions with objects on these layers will generate Impulse events")] public UnityEngine.LayerMask LayerMask;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_ScaleImpactWithMass")] [UnityEngine.Tooltip(@"If checked, signal amplitude will be multiplied by the mass of the impacting object")] public bool ScaleImpactWithMass;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_ScaleImpactWithSpeed")] [UnityEngine.Tooltip(@"If checked, signal amplitude will be multiplied by the speed of the impacting object")] public bool ScaleImpactWithSpeed;
        [UnityEngine.Header(@"How To Generate The Impulse")] [UnityEngine.Serialization.FormerlySerializedAs(@"m_UseImpactDirection")] [UnityEngine.Tooltip(@"If checked, signal direction will be affected by the direction of impact")] public bool UseImpactDirection;
        public CinemachineCollisionImpulseSource() {}
    }

    [UnityEngine.ExecuteAlways] public abstract class CinemachineComponentBase : UnityEngine.MonoBehaviour
    {
        protected const float Epsilon = 0.0001f;
        public virtual bool BodyAppliesAfterAim { get; }
        public UnityEngine.Transform FollowTarget { get; }
        public ICinemachineTargetGroup FollowTargetAsGroup { get; }
        public UnityEngine.Vector3 FollowTargetPosition { get; }
        public UnityEngine.Quaternion FollowTargetRotation { get; }
        public abstract bool IsValid { get; }
        public UnityEngine.Transform LookAtTarget { get; }
        public ICinemachineTargetGroup LookAtTargetAsGroup { get; }
        public UnityEngine.Vector3 LookAtTargetPosition { get; }
        public UnityEngine.Quaternion LookAtTargetRotation { get; }
        public abstract CinemachineCore.Stage Stage { get; }
        public CameraState VcamState { get; }
        public CinemachineVirtualCameraBase VirtualCamera { get; }
        protected CinemachineComponentBase() {}
        public virtual void ForceCameraPosition(UnityEngine.Vector3 pos, UnityEngine.Quaternion rot);
        public virtual float GetMaxDampTime();
        public abstract void MutateCameraState(ref CameraState curState, float deltaTime);
        protected virtual void OnDisable();
        protected virtual void OnEnable();
        public virtual void OnTargetObjectWarped(UnityEngine.Transform target, UnityEngine.Vector3 positionDelta);
        public virtual bool OnTransitionFromCamera(ICinemachineCamera fromCam, UnityEngine.Vector3 worldUp, float deltaTime);
        public virtual void PrePipelineMutateCameraState(ref CameraState curState, float deltaTime);
    }

    [CameraPipeline(CinemachineCore.Stage.Aim)] [SaveDuringPlay] [System.Obsolete(@"CinemachineComposer has been deprecated. Use CinemachineRotationComposer instead")] [UnityEngine.AddComponentMenu(@"")] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineComposer.html")] public class CinemachineComposer : CinemachineComponentBase
    {
        [UnityEngine.Range(-0.5f, 0.5f)] [UnityEngine.Tooltip(@"A non-zero bias will move the target position horizontally away from the center of the soft zone.")] public float m_BiasX;
        [UnityEngine.Range(-0.5f, 0.5f)] [UnityEngine.Tooltip(@"A non-zero bias will move the target position vertically away from the center of the soft zone.")] public float m_BiasY;
        [UnityEngine.Tooltip(@"Force target to center of screen when this camera activates.  If false, will clamp target to the edges of the dead zone")] public bool m_CenterOnActivate = true;
        [UnityEngine.Range(0f, 2f)] [UnityEngine.Tooltip(@"Camera will not rotate vertically if the target is within this range of the position.")] public float m_DeadZoneHeight;
        [UnityEngine.Range(0f, 2f)] [UnityEngine.Tooltip(@"Camera will not rotate horizontally if the target is within this range of the position.")] public float m_DeadZoneWidth;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Space] [UnityEngine.Tooltip(@"How aggressively the camera tries to follow the target in the screen-horizontal direction. Small numbers are more responsive, rapidly orienting the camera to keep the target in the dead zone. Larger numbers give a more heavy slowly responding camera. Using different vertical and horizontal settings can yield a wide range of camera behaviors.")] public float m_HorizontalDamping = 0.5f;
        [UnityEngine.Tooltip(@"If checked, movement along the Y axis will be ignored for lookahead calculations")] public bool m_LookaheadIgnoreY;
        [UnityEngine.Range(0f, 30f)] [UnityEngine.Tooltip(@"Controls the smoothness of the lookahead algorithm.  Larger values smooth out jittery predictions and also increase prediction lag")] public float m_LookaheadSmoothing;
        [UnityEngine.Range(0f, 1f)] [UnityEngine.Space] [UnityEngine.Tooltip(@"This setting will instruct the composer to adjust its target offset based on the motion of the target.  The composer will look at a point where it estimates the target will be this many seconds into the future.  Note that this setting is sensitive to noisy animation, and can amplify the noise, resulting in undesirable camera jitter.  If the camera jitters unacceptably when the target is in motion, turn down this setting, or animate the target more smoothly.")] public float m_LookaheadTime;
        [UnityEngine.Range(-0.5f, 1.5f)] [UnityEngine.Space] [UnityEngine.Tooltip(@"Horizontal screen position for target. The camera will rotate to position the tracked object here.")] public float m_ScreenX = 0.5f;
        [UnityEngine.Range(-0.5f, 1.5f)] [UnityEngine.Tooltip(@"Vertical screen position for target, The camera will rotate to position the tracked object here.")] public float m_ScreenY = 0.5f;
        [UnityEngine.Range(0f, 2f)] [UnityEngine.Tooltip(@"When target is within this region, camera will gradually rotate vertically to re-align towards the desired position, depending on the damping speed.")] public float m_SoftZoneHeight = 0.8f;
        [UnityEngine.Range(0f, 2f)] [UnityEngine.Tooltip(@"When target is within this region, camera will gradually rotate horizontally to re-align towards the desired position, depending on the damping speed.")] public float m_SoftZoneWidth = 0.8f;
        [UnityEngine.Tooltip(@"Target offset from the target object's center in target-local space. Use this to fine-tune the tracking target position when the desired area is not the tracked object's center.")] public UnityEngine.Vector3 m_TrackedObjectOffset;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to follow the target in the screen-vertical direction. Small numbers are more responsive, rapidly orienting the camera to keep the target in the dead zone. Larger numbers give a more heavy slowly responding camera. Using different vertical and horizontal settings can yield a wide range of camera behaviors.")] public float m_VerticalDamping = 0.5f;
        public override bool IsValid { get; }
        public override CinemachineCore.Stage Stage { get; }
        public UnityEngine.Vector3 TrackedPoint { get; }
        public CinemachineComposer() {}
        public override void ForceCameraPosition(UnityEngine.Vector3 pos, UnityEngine.Quaternion rot);
        protected virtual UnityEngine.Vector3 GetLookAtPointAndSetTrackedPoint(UnityEngine.Vector3 lookAt, UnityEngine.Vector3 up, float deltaTime);
        public override float GetMaxDampTime();
        public override void MutateCameraState(ref CameraState curState, float deltaTime);
        public override void OnTargetObjectWarped(UnityEngine.Transform target, UnityEngine.Vector3 positionDelta);
        public override void PrePipelineMutateCameraState(ref CameraState curState, float deltaTime);
    }

    [SaveDuringPlay] [System.Obsolete(@"CinemachineConfiner has been deprecated. Use CinemachineConfiner2D or CinemachineConfiner3D instead")] [UnityEngine.AddComponentMenu(@"")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.ExecuteAlways] public class CinemachineConfiner : CinemachineExtension
    {
        [UnityEngine.Tooltip(@"The 2D shape within which the camera is to be contained")] public UnityEngine.Collider2D m_BoundingShape2D;
        [UnityEngine.Tooltip(@"The volume within which the camera is to be contained")] public UnityEngine.Collider m_BoundingVolume;
        [UnityEngine.Tooltip(@"The confiner can operate using a 2D bounding shape or a 3D bounding volume")] public CinemachineConfiner.Mode m_ConfineMode;
        [UnityEngine.Tooltip(@"If camera is orthographic, screen edges will be confined to the volume.  If not checked, then only the camera center will be confined")] public bool m_ConfineScreenEdges = true;
        [UnityEngine.Range(0f, 10f)] [UnityEngine.Tooltip(@"How gradually to return the camera to the bounding volume if it goes beyond the borders.  Higher numbers are more gradual.")] public float m_Damping;
        public bool IsValid { get; }
        public CinemachineConfiner() {}
        public bool CameraWasDisplaced(CinemachineVirtualCameraBase vcam);
        protected override void ConnectToVcam(bool connect);
        public float GetCameraDisplacementDistance(CinemachineVirtualCameraBase vcam);
        public override float GetMaxDampTime();
        public void InvalidateCache();
        [System.Obsolete(@"Please use InvalidateCache() instead")] public void InvalidatePathCache();
        protected override void PostPipelineStageCallback(CinemachineVirtualCameraBase vcam, CinemachineCore.Stage stage, ref CameraState state, float deltaTime);
        public enum Mode
        {
            Confine2D = 0,
            Confine3D = 1,
        }
    }

    [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Procedural/Extensions/Cinemachine Confiner 2D")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.ExecuteAlways] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineConfiner2D.html")] public class CinemachineConfiner2D : CinemachineExtension
    {
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_BoundingShape2D")] [UnityEngine.Tooltip(@"The 2D shape within which the camera is to be contained.  Can be polygon-, box-, or composite collider 2D.Remark: When assigning a GameObject here in the editor, this will be set to the first Collider2D found on the assigned GameObject!")] public UnityEngine.Collider2D BoundingShape2D;
        [UnityEngine.Range(0f, 5f)] [UnityEngine.Serialization.FormerlySerializedAs(@"m_Damping")] [UnityEngine.Tooltip(@"Damping applied around corners to avoid jumps.  Higher numbers are more gradual.")] public float Damping;
        [FoldoutWithEnabledButton(@"Enabled")] public CinemachineConfiner2D.OversizeWindowSettings OversizeWindow;
        [UnityEngine.Tooltip(@"Size of the slow-down zone at the edge of the bounding shape.")] public float SlowingDistance;
        public bool BoundingShapeIsBaked { get; }
        public CinemachineConfiner2D() {}
        public bool BakeBoundingShape(CinemachineVirtualCameraBase vcam, float maxTimeInSeconds);
        public static float CalculateHalfFrustumHeight(in LensSettings lens, in float cameraPosLocalZ);
        public bool CameraWasDisplaced(CinemachineVirtualCameraBase vcam);
        public float GetCameraDisplacementDistance(CinemachineVirtualCameraBase vcam);
        public override float GetMaxDampTime();
        public void InvalidateBoundingShapeCache();
        [System.Obsolete(@"Call InvalidateBoundingShapeCache() instead.", false)] public void InvalidateCache();
        public void InvalidateLensCache();
        public override void OnTargetObjectWarped(CinemachineVirtualCameraBase vcam, UnityEngine.Transform target, UnityEngine.Vector3 positionDelta);
        protected override void PostPipelineStageCallback(CinemachineVirtualCameraBase vcam, CinemachineCore.Stage stage, ref CameraState state, float deltaTime);
        public struct OversizeWindowSettings
        {
            [UnityEngine.Tooltip(@"Enable optimizing of computation and memory costs in the event that the window size is expected to be larger than will fit inside the confining shape.Enable only if needed, because it's costly")] public bool Enabled;
            [UnityEngine.Tooltip(@"To optimize computation and memory costs, set this to the largest view size that the camera is expected to have.  The confiner will not compute a polygon cache for frustum sizes larger than this.  This refers to the size in world units of the frustum at the confiner plane (for orthographic cameras, this is just the orthographic size).  If set to 0, then this parameter is ignored and a polygon cache will be calculated for all potential window sizes.")] public float MaxWindowSize;
            [UnityEngine.Range(0f, 100f)] [UnityEngine.Tooltip(@"For large window sizes, the confiner will potentially generate polygons with zero area.  The padding may be used to add a small amount of area to these polygons, to prevent them from being a series of disconnected dots.")] public float Padding;
        }
    }

