    [System.Obsolete(@"LegacyLensSettings is deprecated. Use LensSettings instead.")] public struct LegacyLensSettings
    {
        public float Anamorphism;
        public float Aperture;
        public float BarrelClipping;
        public int BladeCount;
        public UnityEngine.Vector2 Curvature;
        public float Dutch;
        public float FarClipPlane;
        public float FieldOfView;
        public float FocusDistance;
        public UnityEngine.Camera.GateFitMode GateFit;
        public int Iso;
        public UnityEngine.Vector2 LensShift;
        [UnityEngine.HideInInspector] public UnityEngine.Vector2 m_SensorSize;
        public LensSettings.OverrideModes ModeOverride;
        public float NearClipPlane;
        public float OrthographicSize;
        public float ShutterSpeed;
        public static LegacyLensSettings Default { get; }
        public void SetFromLensSettings(LensSettings src);
        public LensSettings ToLensSettings();
        public void Validate();
    }

    public struct LensSettings
    {
        [UnityEngine.Tooltip(@"Camera Z roll, or tilt, in degrees.")] public float Dutch;
        [UnityEngine.Tooltip(@"This defines the far region of the renderable range of the camera frustum. Typically you want to set this value as low as possible without cutting off desired distant objects")] public float FarClipPlane;
        [UnityEngine.Tooltip(@"This setting controls the Field of View or Local Length of the lens, depending on whether the camera mode is physical or nonphysical.  Field of View can be either horizontal or vertical, depending on the setting in the Camera component.")] public float FieldOfView;
        [UnityEngine.Tooltip(@"Allows you to select a different camera mode to apply to the Camera component when Cinemachine activates this Virtual Camera.")] public LensSettings.OverrideModes ModeOverride;
        [UnityEngine.Tooltip(@"This defines the near region in the renderable range of the camera frustum. Raising this value will stop the game from drawing things near the camera, which can sometimes come in handy.  Larger values will also increase your shadow resolution.")] public float NearClipPlane;
        [UnityEngine.Tooltip(@"When using an orthographic camera, this defines the half-height, in world coordinates, of the camera view.")] public float OrthographicSize;
        public LensSettings.PhysicalSettings PhysicalProperties;
        public float Aspect { get; }
        public static LensSettings Default { get; }
        public bool IsPhysicalCamera { get; }
        public bool Orthographic { get; }
        public static bool AreEqual(ref LensSettings a, ref LensSettings b);
        public void CopyCameraMode(ref LensSettings fromLens);
        public static LensSettings FromCamera(UnityEngine.Camera fromCamera);
        public void Lerp(in LensSettings lensB, float t);
        public static LensSettings Lerp(LensSettings lensA, LensSettings lensB, float t);
        public void PullInheritedPropertiesFromCamera(UnityEngine.Camera camera);
        public void Validate();
        public enum OverrideModes
        {
            None = 0,
            Orthographic = 1,
            Perspective = 2,
            Physical = 3,
        }
        [UnityEngine.Tooltip(@"These are settings that are used only if IsPhysicalCamera is true")] public struct PhysicalSettings
        {
            [UnityEngine.Range(-1f, 1f)] [UnityEngine.Tooltip(@"Stretches the sensor to simulate an anamorphic look.  Positive values distort the camera vertically, negative values distort the camera horizontally")] public float Anamorphism;
            [UnityEngine.Range(0.7f, 32f)] [UnityEngine.Tooltip(@"The aperture number, in f-stop")] public float Aperture;
            [UnityEngine.Range(0f, 1f)] [UnityEngine.Tooltip(@"The strength of the ""cat-eye"" effect on bokeh (optical vignetting)")] public float BarrelClipping;
            [UnityEngine.Range(3f, 11f)] [UnityEngine.Tooltip(@"The number of diaphragm blades")] public int BladeCount;
            [MinMaxRangeSlider(0.7f, 32f)] [UnityEngine.Tooltip(@"Maps an aperture range to blade curvature")] public UnityEngine.Vector2 Curvature;
            [UnityEngine.Tooltip(@"Distance from the camera lens at which focus is sharpest.  The Depth of Field Volume override uses this value if you set FocusDistanceMode to Camera")] public float FocusDistance;
            [UnityEngine.Tooltip(@"How the image is fitted to the sensor if the aspect ratios differ")] public UnityEngine.Camera.GateFitMode GateFit;
            [UnityEngine.Tooltip(@"The sensor sensitivity (ISO)")] public int Iso;
            [UnityEngine.Tooltip(@"Position of the gate relative to the film back")] public UnityEngine.Vector2 LensShift;
            [SensorSizeProperty] [UnityEngine.Tooltip(@"This is the actual size of the image sensor (in mm)")] public UnityEngine.Vector2 SensorSize;
            [UnityEngine.Tooltip(@"The exposure time, in seconds")] public float ShutterSpeed;
        }
    }

