            public float NormalizedModifierValue { get; }
        }
        public class LensModifier : CinemachineFreeLookModifier.Modifier
        {
            [LensSettingsHideModeOverrideProperty] [UnityEngine.Tooltip(@"Value to take at the bottom of the axis range")] public LensSettings Bottom;
            [LensSettingsHideModeOverrideProperty] [UnityEngine.Tooltip(@"Value to take at the top of the axis range")] public LensSettings Top;
            public LensModifier() {}
            public override void BeforePipeline(CinemachineVirtualCameraBase vcam, ref CameraState state, float deltaTime, float modifierValue);
            public override void Reset(CinemachineVirtualCameraBase vcam);
            public override void Validate(CinemachineVirtualCameraBase vcam);
        }
        public abstract class Modifier
        {
            public virtual System.Type CachedComponentType { get; }
            public virtual bool HasRequiredComponent { get; }
            protected Modifier() {}
            public virtual void AfterPipeline(CinemachineVirtualCameraBase vcam, ref CameraState state, float deltaTime, float modifierValue);
            public virtual void BeforePipeline(CinemachineVirtualCameraBase vcam, ref CameraState state, float deltaTime, float modifierValue);
            public virtual void RefreshCache(CinemachineVirtualCameraBase vcam);
            public virtual void Reset(CinemachineVirtualCameraBase vcam);
            public virtual void Validate(CinemachineVirtualCameraBase vcam);
        }
        public class NoiseModifier : CinemachineFreeLookModifier.ComponentModifier<CinemachineFreeLookModifier.IModifiableNoise>
        {
            [HideFoldout] public CinemachineFreeLookModifier.TopBottomRigs<CinemachineFreeLookModifier.NoiseModifier.NoiseSettings> Noise;
            public NoiseModifier() {}
            public override void AfterPipeline(CinemachineVirtualCameraBase vcam, ref CameraState state, float deltaTime, float modifierValue);
            public override void BeforePipeline(CinemachineVirtualCameraBase vcam, ref CameraState state, float deltaTime, float modifierValue);
            public override void Reset(CinemachineVirtualCameraBase vcam);
            public struct NoiseSettings
            {
                [UnityEngine.Tooltip(@"Multiplier for the noise amplitude")] public float Amplitude;
                [UnityEngine.Tooltip(@"Multiplier for the noise frequency")] public float Frequency;
            }
        }
        public class PositionDampingModifier : CinemachineFreeLookModifier.ComponentModifier<CinemachineFreeLookModifier.IModifiablePositionDamping>
        {
            [HideFoldout] public CinemachineFreeLookModifier.TopBottomRigs<UnityEngine.Vector3> Damping;
            public PositionDampingModifier() {}
            public override void AfterPipeline(CinemachineVirtualCameraBase vcam, ref CameraState state, float deltaTime, float modifierValue);
            public override void BeforePipeline(CinemachineVirtualCameraBase vcam, ref CameraState state, float deltaTime, float modifierValue);
            public override void Reset(CinemachineVirtualCameraBase vcam);
            public override void Validate(CinemachineVirtualCameraBase vcam);
        }
        public class TiltModifier : CinemachineFreeLookModifier.Modifier
        {
            [HideFoldout] public CinemachineFreeLookModifier.TopBottomRigs<float> Tilt;
            public TiltModifier() {}
            public override void AfterPipeline(CinemachineVirtualCameraBase vcam, ref CameraState state, float deltaTime, float modifierValue);
            public override void Reset(CinemachineVirtualCameraBase vcam);
            public override void Validate(CinemachineVirtualCameraBase vcam);
        }
        public struct TopBottomRigs<T>
        {
            [UnityEngine.Tooltip(@"Value to take at the bottom of the axis range")] public T Bottom;
            [UnityEngine.Tooltip(@"Value to take at the top of the axis range")] public T Top;
        }
    }

    [CameraPipeline(CinemachineCore.Stage.Aim)] [SaveDuringPlay] [System.Obsolete(@"CinemachineGroupTransposer has been deprecated. Use CinemachineRotationComposer and CinemachineGroupFraming instead")] [UnityEngine.AddComponentMenu(@"")] public class CinemachineGroupComposer : CinemachineComposer
    {
        [UnityEngine.Tooltip(@"How to adjust the camera to get the desired framing.  You can zoom, dolly in/out, or do both.")] public CinemachineGroupComposer.AdjustmentMode m_AdjustmentMode;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to frame the group. Small numbers are more responsive, rapidly adjusting the camera to keep the group in the frame.  Larger numbers give a heavier more slowly responding camera.")] public float m_FrameDamping = 2f;
        [UnityEngine.Tooltip(@"What screen dimensions to consider when framing.  Can be Horizontal, Vertical, or both")] public CinemachineGroupComposer.FramingMode m_FramingMode = CinemachineGroupComposer.FramingMode.HorizontalAndVertical;
        [UnityEngine.Tooltip(@"The bounding box of the targets should occupy this amount of the screen space.  1 means fill the whole screen.  0.5 means fill half the screen, etc.")] public float m_GroupFramingSize = 0.8f;
        [UnityEngine.Tooltip(@"The maximum distance toward the target that this behaviour is allowed to move the camera.")] public float m_MaxDollyIn = 5000f;
        [UnityEngine.Tooltip(@"The maximum distance away the target that this behaviour is allowed to move the camera.")] public float m_MaxDollyOut = 5000f;
        [UnityEngine.Tooltip(@"Set this to limit how far from the target the camera can get.")] public float m_MaximumDistance = 5000f;
        [UnityEngine.Range(1f, 179f)] [UnityEngine.Tooltip(@"If adjusting FOV, will not set the FOV higher than this.")] public float m_MaximumFOV = 60f;
        [UnityEngine.Tooltip(@"If adjusting Orthographic Size, will not set it higher than this.")] public float m_MaximumOrthoSize = 5000f;
        [UnityEngine.Tooltip(@"Set this to limit how close to the target the camera can get.")] public float m_MinimumDistance = 1f;
        [UnityEngine.Range(1f, 179f)] [UnityEngine.Tooltip(@"If adjusting FOV, will not set the FOV lower than this.")] public float m_MinimumFOV = 3f;
        [UnityEngine.Tooltip(@"If adjusting Orthographic Size, will not set it lower than this.")] public float m_MinimumOrthoSize = 1f;
        public UnityEngine.Bounds LastBounds { get; }
        public UnityEngine.Matrix4x4 LastBoundsMatrix { get; }
        public CinemachineGroupComposer() {}
        public override float GetMaxDampTime();
        public override void MutateCameraState(ref CameraState curState, float deltaTime);
        public enum AdjustmentMode
        {
            ZoomOnly = 0,
            DollyOnly = 1,
            DollyThenZoom = 2,
        }
        public enum FramingMode
        {
            Horizontal = 0,
            Vertical = 1,
            HorizontalAndVertical = 2,
        }
    }

    [RequiredTarget(RequiredTargetAttribute.RequiredTargets.GroupLookAt)] [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Procedural/Extensions/Cinemachine Group Framing")] [UnityEngine.ExecuteAlways] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineGroupFraming.html")] public class CinemachineGroupFraming : CinemachineExtension
    {
        [UnityEngine.Tooltip(@"A nonzero value will offset the group in the camera frame.")] public UnityEngine.Vector2 CenterOffset;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to frame the group. Small numbers are more responsive, rapidly adjusting the camera to keep the group in the frame.  Larger numbers give a heavier more slowly responding camera.")] public float Damping = 2f;
        [UnityEngine.Tooltip(@"Allowable range for the camera to move.  0 is the undollied position.  Negative values move the camera closer to the target.")] [Vector2AsRange] public UnityEngine.Vector2 DollyRange;
        [MinMaxRangeSlider(1f, 179f)] [UnityEngine.Tooltip(@"Allowable FOV range, if adjusting FOV.")] public UnityEngine.Vector2 FovRange;
        [UnityEngine.Tooltip(@"What screen dimensions to consider when framing.  Can be Horizontal, Vertical, or both")] public CinemachineGroupFraming.FramingModes FramingMode = CinemachineGroupFraming.FramingModes.HorizontalAndVertical;
        [UnityEngine.Range(0f, 2f)] [UnityEngine.Tooltip(@"The bounding box of the targets should occupy this amount of the screen space.  1 means fill the whole screen.  0.5 means fill half the screen, etc.")] public float FramingSize = 0.8f;
        [UnityEngine.Tooltip(@"How to adjust the camera to get the desired horizontal and vertical framing.")] public CinemachineGroupFraming.LateralAdjustmentModes LateralAdjustment;
        [UnityEngine.Tooltip(@"Allowable orthographic size range, if adjusting orthographic size.")] [Vector2AsRange] public UnityEngine.Vector2 OrthoSizeRange;
        [UnityEngine.Tooltip(@"How to adjust the camera to get the desired framing size.  You can zoom, dolly in/out, or do both.")] public CinemachineGroupFraming.SizeAdjustmentModes SizeAdjustment = CinemachineGroupFraming.SizeAdjustmentModes.DollyThenZoom;
        public CinemachineGroupFraming() {}
        public override float GetMaxDampTime();
        protected override void PostPipelineStageCallback(CinemachineVirtualCameraBase vcam, CinemachineCore.Stage stage, ref CameraState state, float deltaTime);
        public enum FramingModes
        {
            Horizontal = 0,
            Vertical = 1,
            HorizontalAndVertical = 2,
        }
        public enum LateralAdjustmentModes
        {
            ChangePosition = 0,
            ChangeRotation = 1,
        }
        public enum SizeAdjustmentModes
        {
            ZoomOnly = 0,
            DollyOnly = 1,
            DollyThenZoom = 2,
        }
    }

