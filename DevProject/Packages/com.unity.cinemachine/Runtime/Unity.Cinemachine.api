        public void GenerateImpulseAt(UnityEngine.Vector3 position, UnityEngine.Vector3 velocity);
        public void GenerateImpulseAtPositionWithVelocity(UnityEngine.Vector3 position, UnityEngine.Vector3 velocity);
        public void GenerateImpulseWithForce(float force);
        public void GenerateImpulseWithVelocity(UnityEngine.Vector3 velocity);
    }

    [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Helpers/Cinemachine Input Axis Controller")] [UnityEngine.ExecuteAlways] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineInputAxisController.html")] public class CinemachineInputAxisController : Unity.Cinemachine.InputAxisControllerBase<CinemachineInputAxisController.Reader>
    {
        [UnityEngine.Tooltip(@"If set, Input Actions will be auto-enabled at start")] public bool AutoEnableInputs = true;
        [UnityEngine.Tooltip(@"Leave this at -1 for single-player games.  For multi-player games, set this to be the player index, and the actions will be read from that player's controls")] public int PlayerIndex = -1;
        public CinemachineInputAxisController.Reader.ControlValueReader ReadControlValueOverride;
        public CinemachineInputAxisController() {}
        protected override void InitializeControllerDefaultsForAxis(ref readonly IInputAxisOwner.AxisDescriptor axis, Unity.Cinemachine.InputAxisControllerBase<CinemachineInputAxisController.Reader>.Controller controller);
        protected override void Reset();
        public sealed class Reader : IInputAxisReader
        {
            [UnityEngine.Tooltip(@"Enable this if the input value is inherently dependent on frame time.  For example, mouse deltas will naturally be bigger for longer frames, so in this case the default deltaTime scaling should be canceled.")] public bool CancelDeltaTime;
            [UnityEngine.Tooltip(@"The input value is multiplied by this amount prior to processing.  Controls the input power.  Set it to a negative value to invert the input")] public float Gain = 1f;
            [UnityEngine.Tooltip(@"Action mapping for the Input package.")] public UnityEngine.InputSystem.InputActionReference InputAction;
            public Reader() {}
            public float GetValue(UnityEngine.Object context, IInputAxisOwner.AxisDescriptor.Hints hint);
            public delegate float ControlValueReader(UnityEngine.InputSystem.InputAction action, IInputAxisOwner.AxisDescriptor.Hints hint, UnityEngine.Object context, CinemachineInputAxisController.Reader.ControlValueReader defaultReader);
        }
    }

    [System.Obsolete(@"CinemachineInputAxisDriver has been deprecated. Use DefaultInputAxisDriver instead.")] public struct CinemachineInputAxisDriver
    {
        [UnityEngine.Tooltip(@"The amount of time in seconds it takes to accelerate to a higher speed")] public float accelTime;
        [UnityEngine.Tooltip(@"The amount of time in seconds it takes to decelerate to a lower speed")] public float decelTime;
        [NoSaveDuringPlay] [UnityEngine.Tooltip(@"The value of the input axis.  A value of 0 means no input.  You can drive this directly from a custom input system, or you can set the Axis Name and have the value driven by the internal Input Manager")] public float inputValue;
        [UnityEngine.Tooltip(@"Multiply the input by this amount prior to processing.  Controls the input power.")] public float multiplier;
        [UnityEngine.Tooltip(@"The name of this axis as specified in Unity Input manager. Setting to an empty string will disable the automatic updating of this axis")] public string name;
        public bool Update(float deltaTime, ref AxisBase axis);
        public bool Update(float deltaTime, ref AxisState axis);
        public void Validate();
    }

