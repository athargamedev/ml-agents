    [SaveDuringPlay] [System.Obsolete(@"CinemachineCollider has been deprecated. Use CinemachineDeoccluder instead")] [UnityEngine.AddComponentMenu(@"")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.ExecuteAlways] public class CinemachineCollider : CinemachineExtension, IShotQualityEvaluator
    {
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_PreserveLineOfSight")] [UnityEngine.Space] [UnityEngine.Tooltip(@"When enabled, will attempt to resolve situations where the line of sight to the target is blocked by an obstacle")] public bool m_AvoidObstacles = true;
        [UnityEngine.Tooltip(@"Camera will try to maintain this distance from any obstacle.  Try to keep this value small.  Increase it if you are seeing inside obstacles due to a large FOV on the camera.")] public float m_CameraRadius = 0.1f;
        [UnityEngine.Header(@"Obstacle Detection")] [UnityEngine.Tooltip(@"Objects on these layers will be detected")] public UnityEngine.LayerMask m_CollideAgainst;
        [UnityEngine.Range(0f, 10f)] [UnityEngine.Serialization.FormerlySerializedAs(@"m_Smoothing")] [UnityEngine.Tooltip(@"How gradually the camera returns to its normal position after having been corrected.  Higher numbers will move the camera more gradually back to normal.")] public float m_Damping;
        [UnityEngine.Range(0f, 10f)] [UnityEngine.Tooltip(@"How gradually the camera moves to resolve an occlusion.  Higher numbers will move the camera more gradually.")] public float m_DampingWhenOccluded;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_LineOfSightFeelerDistance")] [UnityEngine.Tooltip(@"The maximum raycast distance when checking if the line of sight to this camera's target is clear.  If the setting is 0 or less, the current actual distance to target will be used.")] public float m_DistanceLimit;
        [TagField] [UnityEngine.Tooltip(@"Obstacles with this tag will be ignored.  It is a good idea to set this field to the target's tag")] public string m_IgnoreTag;
        [UnityEngine.Range(1f, 10f)] [UnityEngine.Tooltip(@"Upper limit on how many obstacle hits to process.  Higher numbers may impact performance.  In most environments, 4 is enough.")] public int m_MaximumEffort = 4;
        [UnityEngine.Tooltip(@"Obstacles closer to the target than this will be ignored")] public float m_MinimumDistanceFromTarget = 0.1f;
        [UnityEngine.Tooltip(@"Don't take action unless occlusion has lasted at least this long.")] public float m_MinimumOcclusionTime;
        [UnityEngine.Header(@"Shot Evaluation")] [UnityEngine.Tooltip(@"If greater than zero, a higher score will be given to shots when the target is closer to this distance.  Set this to zero to disable this feature.")] public float m_OptimalTargetDistance;
        [UnityEngine.Range(0f, 2f)] [UnityEngine.Tooltip(@"Smoothing to apply to obstruction resolution.  Nearest camera point is held for at least this long")] public float m_SmoothingTime;
        [UnityEngine.Tooltip(@"The way in which the Collider will attempt to preserve sight of the target.")] public CinemachineCollider.ResolutionStrategy m_Strategy = CinemachineCollider.ResolutionStrategy.PreserveCameraHeight;
        [UnityEngine.Tooltip(@"Objects on these layers will never obstruct view of the target")] public UnityEngine.LayerMask m_TransparentLayers;
        public CinemachineCollider() {}
        public bool CameraWasDisplaced(CinemachineVirtualCameraBase vcam);
        public float GetCameraDisplacementDistance(CinemachineVirtualCameraBase vcam);
        public override float GetMaxDampTime();
        public bool IsTargetObscured(CinemachineVirtualCameraBase vcam);
        protected override void OnDestroy();
        protected override void PostPipelineStageCallback(CinemachineVirtualCameraBase vcam, CinemachineCore.Stage stage, ref CameraState state, float deltaTime);
        public enum ResolutionStrategy
        {
            PullCameraForward = 0,
            PreserveCameraHeight = 1,
            PreserveCameraDistance = 2,
        }
    }

    [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Helpers/Cinemachine Collision Impulse Source")] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineCollisionImpulseSource.html")] public class CinemachineCollisionImpulseSource : CinemachineImpulseSource
    {
