        {
            public CinemachineBlend Blend;
            public ICinemachineMixer Origin;
        }
        [System.Flags] public enum BlendHints
        {
            SphericalPosition = 1 << 0,
            CylindricalPosition = 1 << 1,
            ScreenSpaceAimWhenTargetsDiffer = 1 << 2,
            InheritPosition = 1 << 3,
            IgnoreTarget = 1 << 4,
            FreezeWhenBlendingOut = 1 << 5,
        }
        public class BrainEvent : UnityEngine.Events.UnityEvent<CinemachineBrain>
        {
            public BrainEvent() {}
        }
        public class CameraEvent : UnityEngine.Events.UnityEvent<ICinemachineMixer, ICinemachineCamera>
        {
            public CameraEvent() {}
        }
