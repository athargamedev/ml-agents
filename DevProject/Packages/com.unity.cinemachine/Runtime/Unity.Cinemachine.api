    public sealed class CinemachineImpulseChannelPropertyAttribute : UnityEngine.PropertyAttribute
    {
        public CinemachineImpulseChannelPropertyAttribute() {}
    }

    public class CinemachineImpulseDefinition
    {
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_AmplitudeGain")] [UnityEngine.Tooltip(@"Legacy mode only: Gain to apply to the amplitudes defined in the signal source.  1 is normal.  Setting this to 0 completely mutes the signal.")] public float AmplitudeGain = 1f;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_CustomImpulseShape")] [UnityEngine.Tooltip(@"Defines the custom shape of the impact signal that will be generated.")] public UnityEngine.AnimationCurve CustomImpulseShape = new();
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_DirectionMode")] [UnityEngine.Tooltip(@"Legacy mode only: How the signal direction behaves as the listener moves away from the origin.")] public CinemachineImpulseManager.ImpulseEvent.DirectionModes DirectionMode;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_DissipationDistance")] [UnityEngine.Tooltip(@"The signal will have no effect outside this radius surrounding the impact point.")] public float DissipationDistance = 100f;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_DissipationMode")] [UnityEngine.Tooltip(@"Legacy mode only: This defines how the signal will dissipate with distance beyond the impact radius.")] public CinemachineImpulseManager.ImpulseEvent.DissipationModes DissipationMode = CinemachineImpulseManager.ImpulseEvent.DissipationModes.ExponentialDecay;
        [UnityEngine.Range(0f, 1f)] [UnityEngine.Serialization.FormerlySerializedAs(@"m_DissipationRate")] [UnityEngine.Tooltip(@"This defines how the widely signal will spread within the effect radius before dissipating with distance from the impact point")] public float DissipationRate;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_FrequencyGain")] [UnityEngine.Tooltip(@"Legacy mode only: Scale factor to apply to the time axis.  1 is normal.  Larger magnitudes will make the signal progress more rapidly.")] public float FrequencyGain = 1f;
        [UnityEngine.Header(@"Spatial Range")] [UnityEngine.Serialization.FormerlySerializedAs(@"m_ImpactRadius")] [UnityEngine.Tooltip(@"Legacy mode only: The signal will have full amplitude in this radius surrounding the impact point.  Beyond that it will dissipate with distance.")] public float ImpactRadius = 100f;
        [CinemachineImpulseChannelProperty] [UnityEngine.Serialization.FormerlySerializedAs(@"m_ImpulseChannel")] [UnityEngine.Tooltip(@"Impulse events generated here will appear on the channels included in the mask.")] public int ImpulseChannel = 1;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_ImpulseDuration")] [UnityEngine.Tooltip(@"The time during which the impact signal will occur.  The signal shape will be stretched to fill that time.")] public float ImpulseDuration = 0.2f;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_ImpulseShape")] [UnityEngine.Tooltip(@"Shape of the impact signal")] public CinemachineImpulseDefinition.ImpulseShapes ImpulseShape;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_ImpulseType")] [UnityEngine.Tooltip(@"How the impulse travels through space and time.")] public CinemachineImpulseDefinition.ImpulseTypes ImpulseType = CinemachineImpulseDefinition.ImpulseTypes.Legacy;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_PropagationSpeed")] [UnityEngine.Tooltip(@"The speed (m/s) at which the impulse propagates through space.  High speeds allow listeners to react instantaneously, while slower speeds allow listeners in the scene to react as if to a wave spreading from the source.")] public float PropagationSpeed = 343f;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Randomize")] [UnityEngine.Tooltip(@"Legacy mode only: Randomize the signal start time")] public bool Randomize = true;
        [CinemachineEmbeddedAssetProperty(true)] [UnityEngine.Header(@"Signal Shape")] [UnityEngine.Serialization.FormerlySerializedAs(@"m_RawSignal")] [UnityEngine.Tooltip(@"Legacy mode only: Defines the signal that will be generated.")] public SignalSourceAsset RawSignal;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_RepeatMode")] [UnityEngine.Tooltip(@"Legacy mode only: How to fit the signal into the envelope time")] public CinemachineImpulseDefinition.RepeatModes RepeatMode;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_TimeEnvelope")] [UnityEngine.Tooltip(@"Legacy mode only: This defines the time-envelope of the signal.  The raw signal will be time-scaled to fit in the envelope.")] public CinemachineImpulseManager.EnvelopeDefinition TimeEnvelope;
        public CinemachineImpulseDefinition() {}
        public CinemachineImpulseManager.ImpulseEvent CreateAndReturnEvent(UnityEngine.Vector3 position, UnityEngine.Vector3 velocity);
        public void CreateEvent(UnityEngine.Vector3 position, UnityEngine.Vector3 velocity);
        public void OnValidate();
        public enum ImpulseShapes
        {
            Custom = 0,
            Recoil = 1,
            Bump = 2,
            Explosion = 3,
            Rumble = 4,
        }
        public enum ImpulseTypes
        {
            Uniform = 0,
            Dissipating = 1,
            Propagating = 2,
            Legacy = 3,
        }
        public enum RepeatModes
        {
            Stretch = 0,
            Loop = 1,
        }
    }

    [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Procedural/Extensions/Cinemachine Impulse Listener")] [UnityEngine.ExecuteAlways] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineImpulseListener.html")] public class CinemachineImpulseListener : CinemachineExtension
    {
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_ApplyAfter")] [UnityEngine.Tooltip(@"When to apply the impulse reaction.  Default is after the Noise stage.  Modify this if necessary to influence the ordering of extension effects")] public CinemachineCore.Stage ApplyAfter = CinemachineCore.Stage.Aim;
        [CinemachineImpulseChannelProperty] [UnityEngine.Serialization.FormerlySerializedAs(@"m_ChannelMask")] [UnityEngine.Tooltip(@"Impulse events on channels not included in the mask will be ignored.")] public int ChannelMask;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Gain")] [UnityEngine.Tooltip(@"Gain to apply to the Impulse signal.  1 is normal strength.  Setting this to 0 completely mutes the signal.")] public float Gain;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_ReactionSettings")] [UnityEngine.Tooltip(@"This controls the secondary reaction of the listener to the incoming impulse.  The impulse might be for example a sharp shock, and the secondary reaction could be a vibration whose amplitude and duration is controlled by the size of the original impulse.  This allows different listeners to respond in different ways to the same impulse signal.")] public CinemachineImpulseListener.ImpulseReaction ReactionSettings;
        [UnityEngine.Tooltip(@"Controls how the Impulse Listener combines multiple impulses active at the current point in space.<b>Additive</b>: Combines all the active signals together, like sound waves.  This is the default.<b>Use Largest</b>: Considers only the signal with the largest amplitude; ignores any others.")] public CinemachineImpulseListener.SignalCombinationModes SignalCombinationMode;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Use2DDistance")] [UnityEngine.Tooltip(@"Enable this to perform distance calculation in 2D (ignore Z)")] public bool Use2DDistance;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_UseCameraSpace")] [UnityEngine.Tooltip(@"Enable this to process all impulse signals in camera space")] public bool UseCameraSpace;
        public CinemachineImpulseListener() {}
        protected override void PostPipelineStageCallback(CinemachineVirtualCameraBase vcam, CinemachineCore.Stage stage, ref CameraState state, float deltaTime);
        public struct ImpulseReaction
        {
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_AmplitudeGain")] [UnityEngine.Tooltip(@"Gain to apply to the amplitudes defined in the signal source.  1 is normal.  Setting this to 0 completely mutes the signal.")] public float AmplitudeGain;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_Duration")] [UnityEngine.Tooltip(@"How long the secondary reaction lasts.")] public float Duration;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_FrequencyGain")] [UnityEngine.Tooltip(@"Scale factor to apply to the time axis.  1 is normal.  Larger magnitudes will make the signal progress more rapidly.")] public float FrequencyGain;
            [UnityEngine.Tooltip(@"Secondary shake that will be triggered by the primary impulse.")] public NoiseSettings m_SecondaryNoise;
            public bool GetReaction(float deltaTime, UnityEngine.Vector3 impulsePos, out UnityEngine.Vector3 pos, out UnityEngine.Quaternion rot);
            public void ReSeed();
        }
        public enum SignalCombinationModes
        {
            Additive = 0,
            UseLargest = 1,
        }
    }

    public class CinemachineImpulseManager
    {
        public bool IgnoreTimeScale;
        public float CurrentTime { get; }
        public static CinemachineImpulseManager Instance { get; }
        public void AddImpulseEvent(CinemachineImpulseManager.ImpulseEvent e);
        public void Clear();
        public bool GetImpulseAt(UnityEngine.Vector3 listenerLocation, bool distance2D, int channelMask, out UnityEngine.Vector3 pos, out UnityEngine.Quaternion rot);
        public bool GetStrongestImpulseAt(UnityEngine.Vector3 listenerLocation, bool distance2D, int channelMask, out UnityEngine.Vector3 pos, out UnityEngine.Quaternion rot);
        public CinemachineImpulseManager.ImpulseEvent NewImpulseEvent();
        public struct EnvelopeDefinition
        {
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_AttackShape")] [UnityEngine.Tooltip(@"Normalized curve defining the shape of the start of the envelope.  If blank a default curve will be used")] public UnityEngine.AnimationCurve AttackShape;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_AttackTime")] [UnityEngine.Tooltip(@"Duration in seconds of the attack.  Attack curve will be scaled to fit.  Must be >= 0.")] public float AttackTime;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_DecayShape")] [UnityEngine.Tooltip(@"Normalized curve defining the shape of the end of the envelope.  If blank a default curve will be used")] public UnityEngine.AnimationCurve DecayShape;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_DecayTime")] [UnityEngine.Tooltip(@"Duration in seconds of the decay.  Decay curve will be scaled to fit.  Must be >= 0.")] public float DecayTime;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_HoldForever")] [UnityEngine.Tooltip(@"If true, then duration is infinite.")] public bool HoldForever;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_ScaleWithImpact")] [UnityEngine.Tooltip(@"If checked, signal amplitude scaling will also be applied to the time envelope of the signal.  Stronger signals will last longer.")] public bool ScaleWithImpact;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_SustainTime")] [UnityEngine.Tooltip(@"Duration in seconds of the central fully-scaled part of the envelope.  Must be >= 0.")] public float SustainTime;
            public static CinemachineImpulseManager.EnvelopeDefinition Default { get; }
            public float Duration { get; }
            public void ChangeStopTime(float offset, bool forceNoDecay);
            public void Clear();
            public float GetValueAt(float offset);
            public void Validate();
        }
        public class ImpulseEvent
        {
            public int Channel;
            public float CustomDissipation;
            public CinemachineImpulseManager.ImpulseEvent.DirectionModes DirectionMode;
            public float DissipationDistance;
            public CinemachineImpulseManager.ImpulseEvent.DissipationModes DissipationMode;
            public CinemachineImpulseManager.EnvelopeDefinition Envelope;
            public UnityEngine.Vector3 Position;
            public float PropagationSpeed;
            public float Radius;
            public ISignalSource6D SignalSource;
            public float StartTime;
            public bool Expired { get; }
            public void Cancel(float time, bool forceNoDecay);
            public void Clear();
            public float DistanceDecay(float distance);
            public bool GetDecayedSignal(UnityEngine.Vector3 listenerPosition, bool use2D, out UnityEngine.Vector3 pos, out UnityEngine.Quaternion rot);
            public enum DirectionModes
            {
                Fixed = 0,
                RotateTowardSource = 1,
            }
            public enum DissipationModes
            {
                LinearDecay = 0,
                SoftDecay = 1,
                ExponentialDecay = 2,
            }
        }
    }

    [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Helpers/Cinemachine Impulse Source")] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineImpulseSource.html")] public class CinemachineImpulseSource : UnityEngine.MonoBehaviour
