    [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Procedural/Extensions/Cinemachine FreeLook Modifier")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.ExecuteAlways] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineFreeLookModifier.html")] public class CinemachineFreeLookModifier : CinemachineExtension
    {
        [UnityEngine.Range(0f, 1f)] [UnityEngine.Tooltip(@"The amount of easing to apply towards the center value. Zero easing blends linearly through the center value, while an easing of 1 smooths the result as it passes over the center value.")] public float Easing;
        [UnityEngine.SerializeReference] [UnityEngine.Tooltip(@"These will modify settings as a function of the FreeLook's Vertical axis value")] public System.Collections.Generic.List<CinemachineFreeLookModifier.Modifier> Modifiers = new();
        public CinemachineFreeLookModifier() {}
        protected override void OnEnable();
        protected override void PostPipelineStageCallback(CinemachineVirtualCameraBase vcam, CinemachineCore.Stage stage, ref CameraState state, float deltaTime);
        public override void PrePipelineMutateCameraStateCallback(CinemachineVirtualCameraBase vcam, ref CameraState curState, float deltaTime);
        public abstract class ComponentModifier<T> : CinemachineFreeLookModifier.Modifier
        {
            protected T CachedComponent;
            public override System.Type CachedComponentType { get; }
            public override bool HasRequiredComponent { get; }
            protected ComponentModifier() {}
            public override void RefreshCache(CinemachineVirtualCameraBase vcam);
        }
        public class CompositionModifier : CinemachineFreeLookModifier.ComponentModifier<CinemachineFreeLookModifier.IModifiableComposition>
        {
            [HideFoldout] public CinemachineFreeLookModifier.TopBottomRigs<ScreenComposerSettings> Composition;
            public CompositionModifier() {}
            public override void AfterPipeline(CinemachineVirtualCameraBase vcam, ref CameraState state, float deltaTime, float modifierValue);
            public override void BeforePipeline(CinemachineVirtualCameraBase vcam, ref CameraState state, float deltaTime, float modifierValue);
            public override void Reset(CinemachineVirtualCameraBase vcam);
            public override void Validate(CinemachineVirtualCameraBase vcam);
        }
        public class DistanceModifier : CinemachineFreeLookModifier.ComponentModifier<CinemachineFreeLookModifier.IModifiableDistance>
        {
            [HideFoldout] public CinemachineFreeLookModifier.TopBottomRigs<float> Distance;
            public DistanceModifier() {}
            public override void AfterPipeline(CinemachineVirtualCameraBase vcam, ref CameraState state, float deltaTime, float modifierValue);
            public override void BeforePipeline(CinemachineVirtualCameraBase vcam, ref CameraState state, float deltaTime, float modifierValue);
            public override void Reset(CinemachineVirtualCameraBase vcam);
            public override void Validate(CinemachineVirtualCameraBase vcam);
        }
        public interface IModifiableComposition
        {
            public ScreenComposerSettings Composition { get; set; }
        }
        public interface IModifiableDistance
        {
            public float Distance { get; set; }
        }
        public interface IModifiableNoise
        {
