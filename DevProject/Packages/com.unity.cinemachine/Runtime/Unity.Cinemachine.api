        }
    }

    [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Helpers/Cinemachine Spline Roll")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.ExecuteInEditMode] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineSplineRoll.html")] public class CinemachineSplineRoll : UnityEngine.MonoBehaviour, UnityEngine.ISerializationCallbackReceiver
