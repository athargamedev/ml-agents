    [CameraPipeline(CinemachineCore.Stage.Body)] [RequiredTarget(RequiredTargetAttribute.RequiredTargets.Tracking)] [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Procedural/Position Control/Cinemachine Orbital Follow")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineOrbitalFollow.html")] public class CinemachineOrbitalFollow : CinemachineComponentBase, CinemachineFreeLookModifier.IModifiableDistance, CinemachineFreeLookModifier.IModifiablePositionDamping, CinemachineFreeLookModifier.IModifierValueSource, IInputAxisOwner, IInputAxisResetSource
    {
