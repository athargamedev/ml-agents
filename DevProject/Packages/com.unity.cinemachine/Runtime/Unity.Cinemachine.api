        [UnityEngine.Tooltip(@"Objects on these layers will be detected")] public UnityEngine.LayerMask CollideAgainst;
        [TagField] [UnityEngine.Tooltip(@"Obstacles with this tag will be ignored.  It is a good idea to set this field to the target's tag")] public string IgnoreTag;
        [UnityEngine.Delayed] [UnityEngine.Tooltip(@"Obstacles closer to the target than this will be ignored")] public float MinimumDistanceFromTarget = 0.3f;
        [FoldoutWithEnabledButton(@"Enabled")] public CinemachineDeoccluder.QualityEvaluation ShotQualityEvaluation;
        [UnityEngine.Tooltip(@"Objects on these layers will never obstruct view of the target")] public UnityEngine.LayerMask TransparentLayers;
        public CinemachineDeoccluder() {}
        public bool CameraWasDisplaced(CinemachineVirtualCameraBase vcam);
        public void DebugCollisionPaths(System.Collections.Generic.List<System.Collections.Generic.List<UnityEngine.Vector3>> paths, System.Collections.Generic.List<System.Collections.Generic.List<UnityEngine.Collider>> obstacles);
        public override void ForceCameraPosition(CinemachineVirtualCameraBase vcam, UnityEngine.Vector3 pos, UnityEngine.Quaternion rot);
        public float GetCameraDisplacementDistance(CinemachineVirtualCameraBase vcam);
        public override float GetMaxDampTime();
        public bool IsTargetObscured(CinemachineVirtualCameraBase vcam);
        protected override void OnDestroy();
        protected override void OnEnable();
        public override void OnTargetObjectWarped(CinemachineVirtualCameraBase vcam, UnityEngine.Transform target, UnityEngine.Vector3 positionDelta);
        protected override void PostPipelineStageCallback(CinemachineVirtualCameraBase vcam, CinemachineCore.Stage stage, ref CameraState state, float deltaTime);
        public struct ObstacleAvoidance
        {
            [UnityEngine.Tooltip(@"Camera will try to maintain this distance from any obstacle.  Try to keep this value small.  Increase it if you are seeing inside obstacles due to a large FOV on the camera.")] public float CameraRadius;
            [UnityEngine.Range(0f, 10f)] [UnityEngine.Tooltip(@"How gradually the camera returns to its normal position after having been corrected.  Higher numbers will move the camera more gradually back to normal.")] public float Damping;
            [UnityEngine.Range(0f, 10f)] [UnityEngine.Tooltip(@"How gradually the camera moves to resolve an occlusion.  Higher numbers will move the camera more gradually.")] public float DampingWhenOccluded;
            [UnityEngine.Tooltip(@"The maximum raycast distance when checking if the line of sight to this camera's target is clear.  If the setting is 0 or less, the current actual distance to target will be used.")] public float DistanceLimit;
            [UnityEngine.Tooltip(@"When enabled, will attempt to resolve situations where the line of sight to the target is blocked by an obstacle")] public bool Enabled;
            [UnityEngine.Range(1f, 10f)] [UnityEngine.Tooltip(@"Upper limit on how many obstacle hits to process.  Higher numbers may impact performance.  In most environments, 4 is enough.")] public int MaximumEffort;
            [UnityEngine.Tooltip(@"Don't take action unless occlusion has lasted at least this long.")] public float MinimumOcclusionTime;
            [UnityEngine.Range(0f, 2f)] [UnityEngine.Tooltip(@"Smoothing to apply to obstruction resolution.  Nearest camera point is held for at least this long")] public float SmoothingTime;
            [UnityEngine.Tooltip(@"The way in which the Deoccluder will attempt to preserve sight of the target.")] public CinemachineDeoccluder.ObstacleAvoidance.ResolutionStrategy Strategy;
            [EnabledProperty(@"Enabled", @"")] public CinemachineDeoccluder.ObstacleAvoidance.FollowTargetSettings UseFollowTarget;
            public struct FollowTargetSettings
            {
                [UnityEngine.Tooltip(@"Use the Follow target when resolving occlusions, instead of the LookAt target.")] public bool Enabled;
                [UnityEngine.Tooltip(@"Vertical offset from the Follow target's root, in target local space")] public float YOffset;
            }
            public enum ResolutionStrategy
            {
                PullCameraForward = 0,
                PreserveCameraHeight = 1,
                PreserveCameraDistance = 2,
            }
        }
        public struct QualityEvaluation
        {
            [UnityEngine.Tooltip(@"If enabled, will evaluate shot quality based on target distance and occlusion")] public bool Enabled;
            [UnityEngine.Tooltip(@"Shots with targets farther from the camera than this will not get a quality boost")] public float FarLimit;
            [UnityEngine.Tooltip(@"High quality shots will be boosted by this fraction of their normal quality")] public float MaxQualityBoost;
            [UnityEngine.Delayed] [UnityEngine.Tooltip(@"Shots with targets closer to the camera than this will not get a quality boost")] public float NearLimit;
            [UnityEngine.Tooltip(@"If greater than zero, maximum quality boost will occur when target is this far from the camera")] public float OptimalDistance;
        }
    }

    [System.Obsolete(@"CinemachineDollyCart has been deprecated. Use CinemachineSplineCart instead.")] [UnityEngine.AddComponentMenu(@"")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.ExecuteAlways] public class CinemachineDollyCart : UnityEngine.MonoBehaviour
    {
        [UnityEngine.Tooltip(@"The path to follow")] public CinemachinePathBase m_Path;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_CurrentDistance")] [UnityEngine.Tooltip(@"The position along the path at which the cart will be placed.  This can be animated directly or, if the velocity is non-zero, will be updated automatically.  The value is interpreted according to the Position Units setting.")] public float m_Position;
        [UnityEngine.Tooltip(@"How to interpret the Path Position.  If set to Path Units, values are as follows: 0 represents the first waypoint on the path, 1 is the second, and so on.  Values in-between are points on the path in between the waypoints.  If set to Distance, then Path Position represents distance along the path.")] public CinemachinePathBase.PositionUnits m_PositionUnits = CinemachinePathBase.PositionUnits.Distance;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Velocity")] [UnityEngine.Tooltip(@"Move the cart with this speed along the path.  The value is interpreted according to the Position Units setting.")] public float m_Speed;
        [UnityEngine.Tooltip(@"When to move the cart, if Velocity is non-zero")] public CinemachineDollyCart.UpdateMethod m_UpdateMethod;
        public CinemachineDollyCart() {}
        public enum UpdateMethod
        {
            Update = 0,
            FixedUpdate = 1,
            LateUpdate = 2,
        }
    }

