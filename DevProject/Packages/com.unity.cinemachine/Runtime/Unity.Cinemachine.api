    public struct ScreenComposerSettings
    {
        [FoldoutWithEnabledButton(@"Enabled")] [UnityEngine.Tooltip(@"The camera will not adjust if the target is within this range of the screen position")] public ScreenComposerSettings.DeadZoneSettings DeadZone;
        [FoldoutWithEnabledButton(@"Enabled")] [UnityEngine.Tooltip(@"The target will not be allowed to be outside this region. When the target is within this region, the camera will gradually adjust to re-align towards the desired position, depending on the damping speed")] public ScreenComposerSettings.HardLimitSettings HardLimits;
        [DelayedVector] [UnityEngine.Tooltip(@"Screen position for target. The camera will adjust to position the tracked object here.  0 is screen center, and +0.5 or -0.5 is screen edge")] public UnityEngine.Vector2 ScreenPosition;
        public UnityEngine.Rect DeadZoneRect { get; set; }
        public static ScreenComposerSettings Default { get; }
        public UnityEngine.Vector2 EffectiveDeadZoneSize { get; }
        public UnityEngine.Vector2 EffectiveHardLimitSize { get; }
        public UnityEngine.Rect HardLimitsRect { get; set; }
        public static bool Approximately(in ScreenComposerSettings a, in ScreenComposerSettings b);
        public static ScreenComposerSettings Lerp(in ScreenComposerSettings a, in ScreenComposerSettings b, float t);
        public void Validate();
        public struct DeadZoneSettings
        {
            public bool Enabled;
            [DelayedVector] [UnityEngine.Tooltip(@"The camera will not adjust if the target is within this range of the screen position.  Full screen size is 1.")] public UnityEngine.Vector2 Size;
        }
        public struct HardLimitSettings
        {
            public bool Enabled;
            [DelayedVector] [UnityEngine.Tooltip(@"A zero Offset means that the hard limits will be centered around the target screen position.  A nonzero Offset will uncenter the hard limits relative to the target screen position.")] public UnityEngine.Vector2 Offset;
            [DelayedVector] [UnityEngine.Tooltip(@"The target will not be allowed to be outside this region. When the target is within this region, the camera will gradually adjust to re-align towards the desired position, depending on the damping speed.  Full screen size is 1")] public UnityEngine.Vector2 Size;
        }
    }

