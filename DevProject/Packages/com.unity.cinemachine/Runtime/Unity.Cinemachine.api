    [CameraPipeline(CinemachineCore.Stage.Body)] [RequiredTarget(RequiredTargetAttribute.RequiredTargets.Tracking)] [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Procedural/Position Control/Cinemachine Third Person Follow")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineThirdPersonFollow.html")] public class CinemachineThirdPersonFollow : CinemachineComponentBase, CinemachineFreeLookModifier.IModifiableDistance, CinemachineFreeLookModifier.IModifiablePositionDamping, CinemachineFreeLookModifier.IModifierValueSource
    {
        [FoldoutWithEnabledButton(@"Enabled")] public CinemachineThirdPersonFollow.ObstacleSettings AvoidObstacles;
        [UnityEngine.Tooltip(@"How far behind the hand the camera will be placed")] public float CameraDistance;
        [UnityEngine.Range(0f, 1f)] [UnityEngine.Tooltip(@"Specifies which shoulder (left, right, or in-between) the camera is on")] public float CameraSide;
        [UnityEngine.Tooltip(@"How responsively the camera tracks the target.  Each axis (camera-local) can have its own setting.  Value is the approximate time it takes the camera to catch up to the target's new position.  Smaller values give a more rigid effect, larger values give a squishier one")] public UnityEngine.Vector3 Damping;
        [UnityEngine.Header(@"Rig")] [UnityEngine.Tooltip(@"Position of the shoulder pivot relative to the Follow target origin.  This offset is in target-local space")] public UnityEngine.Vector3 ShoulderOffset;
        [UnityEngine.Tooltip(@"Vertical offset of the hand in relation to the shoulder.  Arm length will affect the follow target's screen position when the camera rotates vertically")] public float VerticalArmLength;
        public UnityEngine.Collider CurrentObstacle { get; set; }
        public override bool IsValid { get; }
        public override CinemachineCore.Stage Stage { get; }
        public CinemachineThirdPersonFollow() {}
        public override float GetMaxDampTime();
        public void GetRigPositions(out UnityEngine.Vector3 root, out UnityEngine.Vector3 shoulder, out UnityEngine.Vector3 hand);
        public override void MutateCameraState(ref CameraState curState, float deltaTime);
        public override void OnTargetObjectWarped(UnityEngine.Transform target, UnityEngine.Vector3 positionDelta);
        public struct ObstacleSettings
        {
            [UnityEngine.Range(0f, 1f)] [UnityEngine.Tooltip(@"Specifies how close the camera can get to obstacles")] public float CameraRadius;
            [UnityEngine.Tooltip(@"Camera will avoid obstacles on these layers")] public UnityEngine.LayerMask CollisionFilter;
            [UnityEngine.Range(0f, 10f)] [UnityEngine.Tooltip(@"How gradually the camera returns to its normal position after having been corrected by the built-in collision resolution system.  Higher numbers will move the camera more gradually back to normal.")] public float DampingFromCollision;
            [UnityEngine.Range(0f, 10f)] [UnityEngine.Tooltip(@"How gradually the camera moves to correct for occlusions.  Higher numbers will move the camera more gradually.")] public float DampingIntoCollision;
            [UnityEngine.Tooltip(@"If enabled, camera will be pulled in front of occluding obstacles")] public bool Enabled;
            [TagField] [UnityEngine.Tooltip(@"Obstacles with this tag will be ignored.  It is a good idea to set this field to the target's tag")] public string IgnoreTag;
        }
    }

