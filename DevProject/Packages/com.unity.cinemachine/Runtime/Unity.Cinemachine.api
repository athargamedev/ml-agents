    [CameraPipeline(CinemachineCore.Stage.Body)] [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Procedural/Position Control/Cinemachine Spline Dolly")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineSplineDolly.html")] public class CinemachineSplineDolly : CinemachineComponentBase, ISplineReferencer
    {
        [FoldoutWithEnabledButton(@"Enabled")] [NoSaveDuringPlay] [UnityEngine.Tooltip(@"Controls how automatic dolly occurs.  A tracking target may be necessary to use this feature.")] public SplineAutoDolly AutomaticDolly;
        [UnityEngine.Serialization.FormerlySerializedAs(@"CameraUp")] [UnityEngine.Tooltip(@"How to set the camera's rotation and Up.  This will affect the screen composition, because the camera Aim behaviours will always try to respect the Up direction.")] public CinemachineSplineDolly.RotationMode CameraRotation;
        [FoldoutWithEnabledButton(@"Enabled")] [UnityEngine.Tooltip(@"Settings for controlling damping, which causes the camera to move gradually towards the desired spline position")] public CinemachineSplineDolly.DampingSettings Damping;
        [UnityEngine.Tooltip(@"Where to put the camera relative to the spline position.  X is perpendicular to the spline, Y is up, and Z is parallel to the spline.")] public UnityEngine.Vector3 SplineOffset;
        public float CameraPosition { get; set; }
        public override bool IsValid { get; }
        public UnityEngine.Splines.PathIndexUnit PositionUnits { get; set; }
        public UnityEngine.Splines.SplineContainer Spline { get; set; }
        public ref SplineSettings SplineSettings { get; }
        public override CinemachineCore.Stage Stage { get; }
        public CinemachineSplineDolly() {}
        public override float GetMaxDampTime();
        public override void MutateCameraState(ref CameraState curState, float deltaTime);
        protected override void OnDisable();
        protected override void OnEnable();
        public struct DampingSettings
        {
            [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to maintain the desired rotation.  This is only used if Camera Rotation is not Default.")] public float Angular;
            [UnityEngine.Tooltip(@"Enables damping, which causes the camera to move gradually towards the desired spline position")] public bool Enabled;
            [UnityEngine.Tooltip(@"How aggressively the camera tries to maintain the offset along the x, y, or z directions in spline local space. - x represents the axis that is perpendicular to the spline. Use this to smooth out imperfections in the path. This may move the camera off the spline.- y represents the axis that is defined by the spline-local up direction. Use this to smooth out imperfections in the path. This may move the camera off the spline.- z represents the axis that is parallel to the spline. This won't move the camera off the spline.Smaller numbers are more responsive, larger numbers give a heavier more slowly responding camera. Using different settings per axis can yield a wide range of camera behaviors.")] public UnityEngine.Vector3 Position;
        }
        public enum RotationMode
        {
            Default = 0,
            Spline = 1,
            SplineNoRoll = 2,
            FollowTarget = 3,
            FollowTargetNoRoll = 4,
        }
    }

    [CameraPipeline(CinemachineCore.Stage.Aim)] [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Procedural/Rotation Control/Cinemachine Spline Dolly LookAt Targets")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.ExecuteAlways] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineSplineDollyLookAtTargets.html")] public class CinemachineSplineDollyLookAtTargets : CinemachineComponentBase
