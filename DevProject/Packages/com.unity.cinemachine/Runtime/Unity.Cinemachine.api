        [UnityEngine.Serialization.FormerlySerializedAs(@"m_UseCommonLensSetting")] [UnityEngine.Tooltip(@"If enabled, this lens setting will apply to all three child rigs, otherwise the child rig lens settings will be used")] public bool m_CommonLens = true;
        [NoSaveDuringPlay] [UnityEngine.Tooltip(@"Object for the camera children wants to move with (the body target).")] [VcamTargetProperty] public UnityEngine.Transform m_Follow;
        [UnityEngine.Tooltip(@"The definition of Forward.  Camera will follow behind.")] public CinemachineOrbitalTransposer.Heading m_Heading;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_LensAttributes")] [UnityEngine.Tooltip(@"Specifies the lens properties of this Virtual Camera.  This generally mirrors the Unity Camera's lens settings, and will be used to drive the Unity camera when the vcam is active")] public LegacyLensSettings m_Lens;
        [NoSaveDuringPlay] [UnityEngine.Tooltip(@"Object for the camera children to look at (the aim target).")] [VcamTargetProperty] public UnityEngine.Transform m_LookAt;
        [UnityEngine.Tooltip(@"This event fires when a transition occurs")] public CinemachineLegacyCameraEvents.OnCameraLiveEvent m_OnCameraLiveEvent = new();
        [UnityEngine.Tooltip(@"The radius and height of the three orbiting rigs.")] public CinemachineFreeLook.Orbit[] m_Orbits;
        [UnityEngine.Tooltip(@"Controls how automatic recentering of the X axis is accomplished")] public AxisState.Recentering m_RecenterToTargetHeading;
        [UnityEngine.Range(0f, 1f)] [UnityEngine.Serialization.FormerlySerializedAs(@"m_SplineTension")] [UnityEngine.Tooltip(@"Controls how taut is the line that connects the rigs' orbits, which determines final placement on the Y axis")] public float m_SplineCurvature = 0.2f;
        [UnityEngine.Tooltip(@"The Horizontal axis.  Value is -180...180.  This is passed on to the rigs' OrbitalTransposer component")] public AxisState m_XAxis;
        [UnityEngine.Header(@"Axis Control")] [UnityEngine.Tooltip(@"The Vertical axis.  Value is 0..1.  Chooses how to blend the child rigs")] public AxisState m_YAxis;
        [UnityEngine.Tooltip(@"Controls how automatic recentering of the Y axis is accomplished")] public AxisState.Recentering m_YAxisRecentering;
