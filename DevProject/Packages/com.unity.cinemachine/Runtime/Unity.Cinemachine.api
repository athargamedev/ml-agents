    [System.Obsolete(@"Please use CinemachineCameraEvents instead.")] [UnityEngine.AddComponentMenu(@"")] public class CinemachineLegacyCameraEvents : UnityEngine.MonoBehaviour
    {
        [UnityEngine.Tooltip(@"This event fires when the CinemachineCamera goes Live")] public CinemachineLegacyCameraEvents.OnCameraLiveEvent OnCameraLive = new();
