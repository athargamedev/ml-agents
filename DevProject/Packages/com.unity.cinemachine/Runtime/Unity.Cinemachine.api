        [UnityEngine.Serialization.FormerlySerializedAs(@"m_BlendHint")] [UnityEngine.Serialization.FormerlySerializedAs(@"m_PositionBlending")] [UnityEngine.Tooltip(@"Hint for transitioning to and from this CinemachineCamera.  Hints can be combined, although not all combinations make sense.  In the case of conflicting hints, Cinemachine will make an arbitrary choice.")] public CinemachineCore.BlendHints BlendHint;
        [NoSaveDuringPlay] [UnityEngine.Serialization.FormerlySerializedAs(@"m_LookAt")] [UnityEngine.Tooltip(@"The object that the camera is looking at.  Setting this may improve the quality of the blends to and from this camera")] public UnityEngine.Transform LookAtTarget;
        [UnityEngine.HideInInspector] public override UnityEngine.Transform Follow { get; set; }
