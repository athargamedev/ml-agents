    [CameraPipeline(CinemachineCore.Stage.Body)] [RequiredTarget(RequiredTargetAttribute.RequiredTargets.Tracking)] [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Procedural/Position Control/Cinemachine Position Composer")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachinePositionComposer.html")] public class CinemachinePositionComposer : CinemachineComponentBase, CinemachineFreeLookModifier.IModifiableComposition, CinemachineFreeLookModifier.IModifiableDistance, CinemachineFreeLookModifier.IModifiablePositionDamping
    {
