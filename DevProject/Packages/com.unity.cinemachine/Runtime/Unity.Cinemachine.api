        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Instructions")] [UnityEngine.Tooltip(@"The set of instructions associating cameras with states.  These instructions are used to choose the live child at any given moment")] public CinemachineStateDrivenCamera.Instruction[] Instructions;
