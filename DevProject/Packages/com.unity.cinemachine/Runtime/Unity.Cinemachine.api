    [CameraPipeline(CinemachineCore.Stage.Body)] [SaveDuringPlay] [System.Obsolete(@"CinemachineTrackedDolly has been deprecated. Use CinemachineSplineDolly instead.")] [UnityEngine.AddComponentMenu(@"")] public class CinemachineTrackedDolly : CinemachineComponentBase
    {
        [UnityEngine.Tooltip(@"Controls how automatic dollying occurs.  A Follow target is necessary to use this feature.")] public CinemachineTrackedDolly.AutoDolly m_AutoDolly;
        [UnityEngine.Tooltip(@"How to set the virtual camera's Up vector.  This will affect the screen composition, because the camera Aim behaviours will always try to respect the Up direction.")] public CinemachineTrackedDolly.CameraUpMode m_CameraUp;
        [UnityEngine.Tooltip(@"The path to which the camera will be constrained.  This must be non-null.")] public CinemachinePathBase m_Path;
        [UnityEngine.Tooltip(@"Where to put the camera relative to the path position.  X is perpendicular to the path, Y is up, and Z is parallel to the path.  This allows the camera to be offset from the path itself (as if on a tripod, for example).")] public UnityEngine.Vector3 m_PathOffset;
        [UnityEngine.Tooltip(@"The position along the path at which the camera will be placed.  This can be animated directly, or set automatically by the Auto-Dolly feature to get as close as possible to the Follow target.  The value is interpreted according to the Position Units setting.")] public float m_PathPosition;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to track the target rotation's X angle.  Small numbers are more responsive.  Larger numbers give a more heavy slowly responding camera.")] public float m_PitchDamping;
        [UnityEngine.Tooltip(@"How to interpret Path Position.  If set to Path Units, values are as follows: 0 represents the first waypoint on the path, 1 is the second, and so on.  Values in-between are points on the path in between the waypoints.  If set to Distance, then Path Position represents distance along the path.")] public CinemachinePathBase.PositionUnits m_PositionUnits;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to track the target rotation's Z angle.  Small numbers are more responsive.  Larger numbers give a more heavy slowly responding camera.")] public float m_RollDamping;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to maintain its position in a direction perpendicular to the path.  Small numbers are more responsive, rapidly translating the camera to keep the target's x-axis offset.  Larger numbers give a more heavy slowly responding camera. Using different settings per axis can yield a wide range of camera behaviors.")] public float m_XDamping;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to track the target rotation's Y angle.  Small numbers are more responsive.  Larger numbers give a more heavy slowly responding camera.")] public float m_YawDamping;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to maintain its position in the path-local up direction.  Small numbers are more responsive, rapidly translating the camera to keep the target's y-axis offset.  Larger numbers give a more heavy slowly responding camera. Using different settings per axis can yield a wide range of camera behaviors.")] public float m_YDamping;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to maintain its position in a direction parallel to the path.  Small numbers are more responsive, rapidly translating the camera to keep the target's z-axis offset.  Larger numbers give a more heavy slowly responding camera. Using different settings per axis can yield a wide range of camera behaviors.")] public float m_ZDamping = 1f;
        public override bool IsValid { get; }
        public override CinemachineCore.Stage Stage { get; }
        public CinemachineTrackedDolly() {}
        public override float GetMaxDampTime();
        public override void MutateCameraState(ref CameraState curState, float deltaTime);
        public struct AutoDolly
        {
            [UnityEngine.Tooltip(@"If checked, will enable automatic dolly, which chooses a path position that is as close as possible to the Follow target.  Note: this can have significant performance impact")] public bool m_Enabled;
            [UnityEngine.Tooltip(@"Offset, in current position units, from the closest point on the path to the follow target")] public float m_PositionOffset;
            [UnityEngine.Tooltip(@"Search up to this many waypoints on either side of the current position.  Use 0 for Entire path.")] public int m_SearchRadius;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_StepsPerSegment")] [UnityEngine.Tooltip(@"We search between waypoints by dividing the segment into this many straight pieces.  he higher the number, the more accurate the result, but performance is proportionally slower for higher numbers")] public int m_SearchResolution;
            public AutoDolly(bool enabled, float positionOffset, int searchRadius, int stepsPerSegment) {}
        }
        public enum CameraUpMode
        {
            Default = 0,
            Path = 1,
            PathNoRoll = 2,
            FollowTarget = 3,
            FollowTargetNoRoll = 4,
        }
    }

    [CameraPipeline(CinemachineCore.Stage.Body)] [SaveDuringPlay] [System.Obsolete(@"CinemachineTransposer has been deprecated. Use CinemachineFollow instead")] [UnityEngine.AddComponentMenu(@"")] public class CinemachineTransposer : CinemachineComponentBase
    {
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to track the target's orientation.  Small numbers are more responsive.  Larger numbers give a more heavy slowly responding camera.")] public float m_AngularDamping;
        public TargetTracking.AngularDampingMode m_AngularDampingMode;
        [UnityEngine.Tooltip(@"The coordinate space to use when interpreting the offset from the target.  This is also used to set the camera's Up vector, which will be maintained when aiming the camera.")] public TargetTracking.BindingMode m_BindingMode = TargetTracking.BindingMode.LockToTargetWithWorldUp;
        [UnityEngine.Tooltip(@"The distance vector that the transposer will attempt to maintain from the Follow target")] public UnityEngine.Vector3 m_FollowOffset;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to track the target rotation's X angle.  Small numbers are more responsive.  Larger numbers give a more heavy slowly responding camera.")] public float m_PitchDamping;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to track the target rotation's Z angle.  Small numbers are more responsive.  Larger numbers give a more heavy slowly responding camera.")] public float m_RollDamping;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to maintain the offset in the X-axis.  Small numbers are more responsive, rapidly translating the camera to keep the target's x-axis offset.  Larger numbers give a more heavy slowly responding camera. Using different settings per axis can yield a wide range of camera behaviors.")] public float m_XDamping = 1f;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to track the target rotation's Y angle.  Small numbers are more responsive.  Larger numbers give a more heavy slowly responding camera.")] public float m_YawDamping;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to maintain the offset in the Y-axis.  Small numbers are more responsive, rapidly translating the camera to keep the target's y-axis offset.  Larger numbers give a more heavy slowly responding camera. Using different settings per axis can yield a wide range of camera behaviors.")] public float m_YDamping = 1f;
        [UnityEngine.Range(0f, 20f)] [UnityEngine.Tooltip(@"How aggressively the camera tries to maintain the offset in the Z-axis.  Small numbers are more responsive, rapidly translating the camera to keep the target's z-axis offset.  Larger numbers give a more heavy slowly responding camera. Using different settings per axis can yield a wide range of camera behaviors.")] public float m_ZDamping = 1f;
        public UnityEngine.Vector3 EffectiveOffset { get; }
        public override bool IsValid { get; }
        public override CinemachineCore.Stage Stage { get; }
        protected TargetTracking.TrackerSettings TrackerSettings { get; }
        public CinemachineTransposer() {}
        public override void ForceCameraPosition(UnityEngine.Vector3 pos, UnityEngine.Quaternion rot);
        public override float GetMaxDampTime();
        public override void MutateCameraState(ref CameraState curState, float deltaTime);
        public override void OnTargetObjectWarped(UnityEngine.Transform target, UnityEngine.Vector3 positionDelta);
        protected virtual void OnValidate();
    }

    [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Helpers/Cinemachine Trigger Action")] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineTriggerAction.html")] public class CinemachineTriggerAction : UnityEngine.MonoBehaviour
    {
        [UnityEngine.Header(@"Trigger Object Filter")] [UnityEngine.Serialization.FormerlySerializedAs(@"m_LayerMask")] [UnityEngine.Tooltip(@"Only triggers generated by objects on these layers will be considered")] public UnityEngine.LayerMask LayerMask;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_OnObjectEnter")] [UnityEngine.Tooltip(@"What action to take when an eligible object enters the collider or trigger zone")] public CinemachineTriggerAction.ActionSettings OnObjectEnter;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_OnObjectExit")] [UnityEngine.Tooltip(@"What action to take when an eligible object exits the collider or trigger zone")] public CinemachineTriggerAction.ActionSettings OnObjectExit;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_Repeating")] [UnityEngine.Tooltip(@"Repeat the action for all subsequent trigger entries")] public bool Repeating = true;
        [NoSaveDuringPlay] [UnityEngine.Serialization.FormerlySerializedAs(@"m_SkipFirst")] [UnityEngine.Tooltip(@"Skip this many trigger entries before taking action")] public int SkipFirst;
        [TagField] [UnityEngine.Serialization.FormerlySerializedAs(@"m_WithoutTag")] [UnityEngine.Tooltip(@"Triggers generated by objects with this tag will be ignored")] public string WithoutTag;
        [TagField] [UnityEngine.Serialization.FormerlySerializedAs(@"m_WithTag")] [UnityEngine.Tooltip(@"If set, only triggers generated by objects with this tag will be considered")] public string WithTag;
        public CinemachineTriggerAction() {}
        public struct ActionSettings
        {
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_Action")] [UnityEngine.Tooltip(@"What action to take")] public CinemachineTriggerAction.ActionSettings.ActionModes Action;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_BoostAmount")] [UnityEngine.Tooltip(@"If PriorityBoost, this amount will be added to the virtual camera's priority")] public int BoostAmount;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_Event")] [UnityEngine.Tooltip(@"This event will be invoked")] public CinemachineTriggerAction.ActionSettings.TriggerEvent Event = new();
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_Mode")] [UnityEngine.Tooltip(@"How to interpret the start time")] public CinemachineTriggerAction.ActionSettings.TimeModes Mode;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_StartTime")] [UnityEngine.Tooltip(@"If playing a timeline, start at this time")] public float StartTime;
            [UnityEngine.Serialization.FormerlySerializedAs(@"m_Target")] [UnityEngine.Tooltip(@"The target object on which to operate.  If null, then the current behaviour/GameObject will be used")] public UnityEngine.Object Target;
            public ActionSettings(CinemachineTriggerAction.ActionSettings.ActionModes action) {}
            public void Invoke();
            public enum ActionModes
            {
                EventOnly = 0,
                PriorityBoost = 1,
                Activate = 2,
                Deactivate = 3,
                Enable = 4,
                Disable = 5,
                Play = 6,
                Stop = 7,
            }
            public enum TimeModes
            {
                FromStart = 0,
                FromEnd = 1,
                BeforeNow = 2,
                AfterNow = 3,
            }
            public class TriggerEvent : UnityEngine.Events.UnityEvent
            {
                public TriggerEvent() {}
            }
        }
    }

