            [UnityEngine.Serialization.FormerlySerializedAs(@"m_HeadingDefinition")] [UnityEngine.Tooltip(@"How 'forward' is defined.  The camera will be placed by default behind the target.  PositionDelta will consider 'forward' to be the direction in which the target is moving.")] public CinemachineOrbitalTransposer.Heading.HeadingDefinition m_Definition;
