        protected void SetLiveChild(ICinemachineCamera activeCamera, UnityEngine.Vector3 worldUp, float deltaTime);
        protected virtual bool UpdateCameraCache();
        public struct DefaultTargetSettings
        {
            [UnityEngine.Tooltip(@"If enabled, a default target will be available.  It will be used if a child rig needs a target and doesn't specify one itself.")] public bool Enabled;
            [NoSaveDuringPlay] [UnityEngine.Tooltip(@"Default target for the camera children, which may be used if the child rig does not specify a target of its own.")] public CameraTarget Target;
        }
    }

