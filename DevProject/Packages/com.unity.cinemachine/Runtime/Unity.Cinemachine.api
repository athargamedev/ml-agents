    public abstract class CinemachineVirtualCameraBase : UnityEngine.MonoBehaviour, ICinemachineCamera
    {
        public float FollowTargetAttachment;
        public float LookAtTargetAttachment;
        [NoSaveDuringPlay] [UnityEngine.Tooltip(@"The output channel functions like Unity layers.  Use it to filter the output of CinemachineCameras to different CinemachineBrains, for instance in a multi-screen environemnt.")] public OutputChannels OutputChannel = OutputChannels.Default;
        [EnabledProperty(@"Enabled", @"(using default)")] [NoSaveDuringPlay] [UnityEngine.Tooltip(@"Priority can be used to control which Cm Camera is live when multiple CM Cameras are active simultaneously.  The most-recently-activated CinemachineCamera will take control, unless there is another Cm Camera active with a higher priority.  In general, the most-recently-activated highest-priority CinemachineCamera will control the main camera. The default priority is value 0.  Often it is sufficient to leave the default setting.  In special cases where you want a CinemachineCamera to have a higher or lower priority value than 0, you can set it here.")] public PrioritySettings Priority;
        [UnityEngine.Serialization.FormerlySerializedAs(@"m_StandbyUpdate")] [UnityEngine.Tooltip(@"When the virtual camera is not live, this is how often the virtual camera will be updated.  Set this to tune for performance. Most of the time Never is fine, unless the virtual camera is doing shot evaluation.")] public CinemachineVirtualCameraBase.StandbyUpdateMode StandbyUpdate = CinemachineVirtualCameraBase.StandbyUpdateMode.RoundRobin;
        public virtual string Description { get; }
        public abstract UnityEngine.Transform Follow { get; set; }
        public ICinemachineTargetGroup FollowTargetAsGroup { get; }
        public CinemachineVirtualCameraBase FollowTargetAsVcam { get; }
        public bool FollowTargetChanged { get; }
        protected virtual bool IsDprecated { get; }
        public bool IsLive { get; }
        public bool IsValid { get; }
        public abstract UnityEngine.Transform LookAt { get; set; }
        public ICinemachineTargetGroup LookAtTargetAsGroup { get; }
        public CinemachineVirtualCameraBase LookAtTargetAsVcam { get; }
        public bool LookAtTargetChanged { get; }
        public string Name { get; }
        public ICinemachineMixer ParentCamera { get; }
        public virtual bool PreviousStateIsValid { get; set; }
        public abstract CameraState State { get; }
        protected CinemachineVirtualCameraBase() {}
        public void CancelDamping(bool updateNow = false);
        public float DetachedFollowTargetDamp(float initial, float dampTime, float deltaTime);
        public UnityEngine.Vector3 DetachedFollowTargetDamp(UnityEngine.Vector3 initial, float dampTime, float deltaTime);
        public UnityEngine.Vector3 DetachedFollowTargetDamp(UnityEngine.Vector3 initial, UnityEngine.Vector3 dampTime, float deltaTime);
        public float DetachedLookAtTargetDamp(float initial, float dampTime, float deltaTime);
        public UnityEngine.Vector3 DetachedLookAtTargetDamp(UnityEngine.Vector3 initial, float dampTime, float deltaTime);
        public UnityEngine.Vector3 DetachedLookAtTargetDamp(UnityEngine.Vector3 initial, UnityEngine.Vector3 dampTime, float deltaTime);
        public virtual void ForceCameraPosition(UnityEngine.Vector3 pos, UnityEngine.Quaternion rot);
        public virtual CinemachineComponentBase GetCinemachineComponent(CinemachineCore.Stage stage);
        public virtual float GetMaxDampTime();
        public abstract void InternalUpdateCameraState(UnityEngine.Vector3 worldUp, float deltaTime);
        protected bool InvokeOnTransitionInExtensions(ICinemachineCamera fromCam, UnityEngine.Vector3 worldUp, float deltaTime);
        protected void InvokePostPipelineStageCallback(CinemachineVirtualCameraBase vcam, CinemachineCore.Stage stage, ref CameraState newState, float deltaTime);
        protected void InvokePrePipelineMutateCameraStateCallback(CinemachineVirtualCameraBase vcam, ref CameraState newState, float deltaTime);
        public bool IsParticipatingInBlend();
        [System.Obsolete(@"Please use Prioritize()")] public void MoveToTopOfPrioritySubqueue();
        public virtual void OnCameraActivated(ICinemachineCamera.ActivationEventParams evt);
        protected virtual void OnDestroy();
        protected virtual void OnDisable();
        protected virtual void OnEnable();
        public virtual void OnTargetObjectWarped(UnityEngine.Transform target, UnityEngine.Vector3 positionDelta);
        protected virtual void OnTransformParentChanged();
        public virtual void OnTransitionFromCamera(ICinemachineCamera fromCam, UnityEngine.Vector3 worldUp, float deltaTime);
        protected virtual void PerformLegacyUpgrade(int streamedVersion);
        public void Prioritize();
        protected CameraState PullStateFromVirtualCamera(UnityEngine.Vector3 worldUp, ref LensSettings lens);
        public UnityEngine.Transform ResolveFollow(UnityEngine.Transform localFollow);
        public UnityEngine.Transform ResolveLookAt(UnityEngine.Transform localLookAt);
        protected virtual void Start();
        protected virtual void Update();
        public void UpdateCameraState(UnityEngine.Vector3 worldUp, float deltaTime);
        public void UpdateTargetCache();
        public enum StandbyUpdateMode
        {
            Never = 0,
            Always = 1,
            RoundRobin = 2,
        }
    }

    [SaveDuringPlay] [UnityEngine.AddComponentMenu(@"Cinemachine/Procedural/Extensions/Cinemachine Volume Settings")] [UnityEngine.DisallowMultipleComponent] [UnityEngine.ExecuteAlways] [UnityEngine.HelpURL(@"https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineVolumeSettings.html")] public class CinemachineVolumeSettings : CinemachineExtension
