    }

    public static class VertexPositioning
    {
        public static void SetSharedVertexPosition(this ProBuilderMesh mesh, int sharedVertexHandle, Vector3 position);
        public static void TranslateVertices(this ProBuilderMesh mesh, System.Collections.Generic.IEnumerable<int> indexes, Vector3 offset);
        public static void TranslateVertices(this ProBuilderMesh mesh, System.Collections.Generic.IEnumerable<Edge> edges, Vector3 offset);
        public static void TranslateVertices(this ProBuilderMesh mesh, System.Collections.Generic.IEnumerable<Face> faces, Vector3 offset);
        public static void TranslateVerticesInWorldSpace(this ProBuilderMesh mesh, int[] indexes, Vector3 offset);
        public static Vector3[] VerticesInWorldSpace(this ProBuilderMesh mesh);
    }

    public enum WindingOrder
    {
        Unknown = 0,
        Clockwise = 1,
        CounterClockwise = 2,
    }

    public sealed class WingedEdge : System.IEquatable<WingedEdge>
    {
        public EdgeLookup edge { get; }
        public Face face { get; }
        public WingedEdge next { get; }
        public WingedEdge opposite { get; }
        public WingedEdge previous { get; }
        public int Count();
        public override bool Equals(object obj);
        public bool Equals(WingedEdge other);
        public WingedEdge GetAdjacentEdgeWithCommonIndex(int common);
        public override int GetHashCode();
        public static System.Collections.Generic.Dictionary<int, System.Collections.Generic.List<WingedEdge>> GetSpokes(System.Collections.Generic.List<WingedEdge> wings);
        public static System.Collections.Generic.List<WingedEdge> GetWingedEdges(ProBuilderMesh mesh, bool oneWingPerFace = false);
        public static System.Collections.Generic.List<WingedEdge> GetWingedEdges(ProBuilderMesh mesh, System.Collections.Generic.IEnumerable<Face> faces, bool oneWingPerFace = false);
        public static System.Collections.Generic.List<Edge> SortEdgesByAdjacency(Face face);
        public static void SortEdgesByAdjacency(System.Collections.Generic.List<Edge> edges);
        public override string ToString();
    }

    public sealed class WingedEdgeEnumerator : System.Collections.Generic.IEnumerator<WingedEdge>, System.Collections.IEnumerator, System.IDisposable
    {
        public WingedEdge Current { get; }
        public WingedEdgeEnumerator(WingedEdge start) {}
        public void Dispose();
        public bool MoveNext();
        public void Reset();
    }
}

